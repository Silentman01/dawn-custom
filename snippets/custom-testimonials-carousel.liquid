{%- liquid
  assign items_count = 0
  if text_1 != blank
    assign items_count = items_count | plus: 1
  endif
  if text_2 != blank
    assign items_count = items_count | plus: 1
  endif
  if text_3 != blank
    assign items_count = items_count | plus: 1
  endif
  assign carousel_speed = speed | default: 5 | times: 1000
  assign s_color = star_color | default: '#ffcc00'
-%}

{% style %}
  .rv-carousel{--rv-bg:#f2f2f2;--rv-radius:1.2rem;--rv-text:#121212;--rv-author:#121212;--rv-dot:#c4c0bb;--rv-dot-active:#121212;--rv-avatar-radius:4rem;width:100%;overflow:hidden;position:relative}
  .rv-track{display:flex;transition:transform .4s ease}
  .rv-slide{min-width:100%;box-sizing:border-box;padding:14px;display:flex;align-items:center;gap:10px;background:var(--rv-bg);border-radius:var(--rv-radius)}
  .rv-avatar{width:44px;height:44px;min-width:44px;border-radius:var(--rv-avatar-radius);object-fit:cover}
  .rv-content{display:flex;flex-direction:column;gap:4px}
  .rv-stars-row{display:flex;align-items:center;gap:6px}
  .rv-stars{display:flex;align-items:center;gap:1px}
  .rv-stars svg{width:14px;height:14px}
  .rv-verified{display:inline-flex;align-items:center;gap:3px;font-size:11px;color:#1a73e8;font-weight:500;white-space:nowrap}
  .rv-verified svg{width:14px;height:14px;fill:#1a73e8;flex-shrink:0}
  .rv-text{font-size:13px;line-height:1.4;color:var(--rv-text);margin:0}
  .rv-author{font-size:12px;line-height:1.3;color:var(--rv-author);opacity:.7;margin:0}
  .rv-dots{display:flex;justify-content:center;gap:6px;margin-top:10px}
  .rv-dot{width:8px;height:8px;border-radius:50%;background:var(--rv-dot);border:none;padding:0;cursor:pointer;transition:transform .2s ease,background .2s ease}
  .rv-dot.active{background:var(--rv-dot-active);transform:scale(1.5)}
  @media(max-width:749px){.rv-slide{padding:10px;gap:8px}.rv-avatar{width:36px;height:36px;min-width:36px}.rv-text{font-size:12px}.rv-author{font-size:11px}.rv-verified{font-size:10px}}
{% endstyle %}

{%- if items_count > 0 -%}
<div class="rv-carousel" data-speed="{{ carousel_speed }}">
  <div class="rv-track">
    {%- for i in (1..3) -%}
      {%- liquid
        case i
          when 1
            assign rv_image = image_1
            assign rv_author = author_1
            assign rv_text = text_1
          when 2
            assign rv_image = image_2
            assign rv_author = author_2
            assign rv_text = text_2
          when 3
            assign rv_image = image_3
            assign rv_author = author_3
            assign rv_text = text_3
        endcase
      -%}
      {%- if rv_text != blank -%}
        <div class="rv-slide">
          {%- if rv_image != blank -%}
            <img class="rv-avatar" src="{{ rv_image | image_url: width: 88 }}" alt="{{ rv_author | strip_html | escape }}" width="44" height="44" loading="lazy">
          {%- endif -%}
          <div class="rv-content">
            {%- if show_stars != false or show_verified != false -%}
            <div class="rv-stars-row">
              {%- if show_stars != false -%}
              <div class="rv-stars" style="color: {{ s_color }};">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
              </div>
              {%- endif -%}
              {%- if show_verified != false -%}
              <span class="rv-verified">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 1l3.09 2.34L18.5 3l1.28 3.17L22 9.27l-1.64 3.07.36 3.48-3.2 1.43L15.09 20 12 19.09 8.91 20l-2.53-2.75-3.2-1.43.36-3.48L1.9 9.27l2.22-3.1L5.5 3l3.41.34L12 1zm-1.41 14.59l7.07-7.07-1.41-1.41-5.66 5.66-2.83-2.83-1.41 1.41 4.24 4.24z"/></svg>
                Verified Purchase
              </span>
              {%- endif -%}
            </div>
            {%- endif -%}
            <p class="rv-text">{{ rv_text }}</p>
            {%- if rv_author != blank -%}
              <p class="rv-author">{{ rv_author }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if items_count > 1 -%}
    <div class="rv-dots"></div>
  {%- endif -%}
</div>

<script>
(function(){
  var el=document.currentScript.previousElementSibling;
  while(el&&!el.classList.contains('rv-carousel'))el=el.previousElementSibling;
  if(!el)return;
  var track=el.querySelector('.rv-track'),
      slides=el.querySelectorAll('.rv-slide'),
      dotsWrap=el.querySelector('.rv-dots'),
      count=slides.length,
      idx=0,
      speed=parseInt(el.getAttribute('data-speed'),10)||5000,
      timer,startX,dx;
  if(count<2)return;
  function buildDots(){if(!dotsWrap)return;for(var i=0;i<count;i++){var d=document.createElement('button');d.className='rv-dot'+(i===0?' active':'');d.setAttribute('aria-label','Slide '+(i+1));d.addEventListener('click',(function(n){return function(){go(n)}})(i));dotsWrap.appendChild(d)}}
  function go(n){idx=(n+count)%count;track.style.transform='translateX(-'+idx*100+'%)';if(!dotsWrap)return;var dots=dotsWrap.querySelectorAll('.rv-dot');for(var i=0;i<dots.length;i++)dots[i].className='rv-dot'+(i===idx?' active':'')}
  function next(){go(idx+1)}
  function start(){timer=setInterval(next,speed)}
  function stop(){clearInterval(timer)}
  buildDots();start();
  el.addEventListener('mouseenter',stop);
  el.addEventListener('mouseleave',start);
  el.addEventListener('touchstart',function(e){dx=0;startX=e.touches[0].clientX;stop()},{passive:true});
  el.addEventListener('touchmove',function(e){dx=e.touches[0].clientX-startX},{passive:true});
  el.addEventListener('touchend',function(){if(dx>40)go(idx-1);else if(dx<-40)go(idx+1);start()});
})();
</script>
{%- endif -%}