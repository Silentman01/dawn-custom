{% style %}
  .rv-carousel{--rv-bg:#f2f2f2;--rv-radius:1.2rem;--rv-text:#121212;--rv-author:#121212;--rv-dot:#c4c0bb;--rv-dot-active:#121212;--rv-avatar-radius:4rem;width:100%;overflow:hidden;position:relative}
  .rv-track{display:flex;transition:transform .4s ease}
  .rv-slide{min-width:100%;box-sizing:border-box;padding:14px;display:flex;align-items:flex-start;gap:10px;background:var(--rv-bg);border-radius:var(--rv-radius)}
  .rv-avatar{width:44px;height:44px;min-width:44px;border-radius:var(--rv-avatar-radius);object-fit:cover}
  .rv-content{display:flex;flex-direction:column;gap:4px}
  .rv-text{font-size:13px;line-height:1.4;color:var(--rv-text);margin:0}
  .rv-author{font-size:12px;line-height:1.3;color:var(--rv-author);opacity:.7;margin:0}
  .rv-dots{display:flex;justify-content:center;gap:6px;margin-top:10px}
  .rv-dot{width:8px;height:8px;border-radius:50%;background:var(--rv-dot);border:none;padding:0;cursor:pointer;transition:transform .2s ease,background .2s ease}
  .rv-dot.active{background:var(--rv-dot-active);transform:scale(1.5)}
  @media(max-width:749px){.rv-slide{padding:10px;gap:8px}.rv-avatar{width:36px;height:36px;min-width:36px}.rv-text{font-size:12px}.rv-author{font-size:11px}}
{% endstyle %}

<div class="rv-carousel" data-speed="5000">
  <div class="rv-track">
    <div class="rv-slide">
      <img class="rv-avatar" src="https://placehold.co/88x88/e8e8e8/999?text=A" alt="Avatar" width="44" height="44" loading="lazy">
      <div class="rv-content">
        <p class="rv-text">Absolutely love this product! The quality exceeded my expectations and it arrived faster than I thought.</p>
        <p class="rv-author">Sarah M. &mdash; Los Angeles, CA</p>
      </div>
    </div>
    <div class="rv-slide">
      <img class="rv-avatar" src="https://placehold.co/88x88/e8e8e8/999?text=B" alt="Avatar" width="44" height="44" loading="lazy">
      <div class="rv-content">
        <p class="rv-text">This is my third purchase and I keep coming back. Consistent quality every single time.</p>
        <p class="rv-author">James R. &mdash; Austin, TX</p>
      </div>
    </div>
    <div class="rv-slide">
      <img class="rv-avatar" src="https://placehold.co/88x88/e8e8e8/999?text=C" alt="Avatar" width="44" height="44" loading="lazy">
      <div class="rv-content">
        <p class="rv-text">Perfect gift idea. My friend was thrilled when she opened it. Will definitely order again soon!</p>
        <p class="rv-author">Emily T. &mdash; New York, NY</p>
      </div>
    </div>
  </div>
  <div class="rv-dots"></div>
</div>

<script>
(function(){
  var el=document.currentScript.previousElementSibling;
  while(el&&!el.classList.contains('rv-carousel'))el=el.previousElementSibling;
  if(!el)return;
  var track=el.querySelector('.rv-track'),
      slides=el.querySelectorAll('.rv-slide'),
      dotsWrap=el.querySelector('.rv-dots'),
      count=slides.length,
      idx=0,
      speed=parseInt(el.getAttribute('data-speed'),10)||5000,
      timer,startX,dx;
  function buildDots(){for(var i=0;i<count;i++){var d=document.createElement('button');d.className='rv-dot'+(i===0?' active':'');d.setAttribute('aria-label','Slide '+(i+1));d.addEventListener('click',(function(n){return function(){go(n)}})(i));dotsWrap.appendChild(d)}}
  function go(n){idx=(n+count)%count;track.style.transform='translateX(-'+idx*100+'%)';var dots=dotsWrap.querySelectorAll('.rv-dot');for(var i=0;i<dots.length;i++)dots[i].className='rv-dot'+(i===idx?' active':'')}
  function next(){go(idx+1)}
  function start(){timer=setInterval(next,speed)}
  function stop(){clearInterval(timer)}
  buildDots();start();
  el.addEventListener('mouseenter',stop);
  el.addEventListener('mouseleave',start);
  el.addEventListener('touchstart',function(e){dx=0;startX=e.touches[0].clientX;stop()},{passive:true});
  el.addEventListener('touchmove',function(e){dx=e.touches[0].clientX-startX},{passive:true});
  el.addEventListener('touchend',function(){if(dx>40)go(idx-1);else if(dx<-40)go(idx+1);start()});
})();
</script>