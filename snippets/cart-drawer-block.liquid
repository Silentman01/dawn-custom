{%- comment -%}
  Renders a single cart drawer block.
  Args: block (section block object), cart (cart object)
{%- endcomment -%}

{%- liquid
  assign margin_style = ''
  if block.settings.margin_top != blank and block.settings.margin_top > 0
    assign mt = block.settings.margin_top | divided_by: 10.0
    assign margin_style = margin_style | append: 'margin-top:' | append: mt | append: 'rem;'
  endif
  if block.settings.margin_bottom != blank and block.settings.margin_bottom > 0
    assign mb = block.settings.margin_bottom | divided_by: 10.0
    assign margin_style = margin_style | append: 'margin-bottom:' | append: mb | append: 'rem;'
  endif
  if block.settings.block_bg_color != blank
    assign margin_style = margin_style | append: '--block-bg:' | append: block.settings.block_bg_color | append: ';'
  endif
  if block.settings.block_text_color != blank
    assign margin_style = margin_style | append: '--block-text:' | append: block.settings.block_text_color | append: ';'
  endif
-%}

{%- case block.type -%}

  {%- when 'free_shipping_bar' -%}
    {%- liquid
      assign threshold_cents = block.settings.threshold | times: 100
      assign cart_total = cart.total_price
      assign remaining_cents = threshold_cents | minus: cart_total
      assign progress = cart_total | times: 100 | divided_by: threshold_cents
      if progress > 100
        assign progress = 100
      endif
      assign reached = false
      if cart_total >= threshold_cents
        assign reached = true
      endif
      assign remaining_money = remaining_cents | money
    -%}
    <div class="cart-drawer-block cart-drawer-block--shipping" {{ block.shopify_attributes }}
      style="
        --shipping-bar-color: {{ block.settings.bar_color }};
        --shipping-bg-color: {{ block.settings.bg_color }};
        --shipping-text-color: {{ block.settings.text_color }};
        {{ margin_style }}
      "
    >
      <div class="shipping-bar">
        <div class="shipping-bar__message">
          {%- if reached -%}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>{{ block.settings.success_message }}</span>
          {%- else -%}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13 16.5H3.5V7.5H16.5V10M21 14V12L19 7.5H16.5V14H21ZM21 14H23V17H21.5M16.5 17H7M3.5 17H2V14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="5" cy="17.5" r="2" stroke="currentColor" stroke-width="1.5"/><circle cx="19" cy="17.5" r="2" stroke="currentColor" stroke-width="1.5"/></svg>
            <span>{{ block.settings.message | replace: '[amount]', remaining_money }}</span>
          {%- endif -%}
        </div>
        <div class="shipping-bar__track">
          <div class="shipping-bar__fill" style="width: {{ progress }}%"></div>
        </div>
      </div>
    </div>

  {%- when 'countdown_timer' -%}
    <cart-drawer-countdown
      class="cart-drawer-block cart-drawer-block--countdown"
      {{ block.shopify_attributes }}
      data-duration="{{ block.settings.duration }}"
      data-expired-message="{{ block.settings.expired_message | escape }}"
      style="
        {{ margin_style }}
        --countdown-text-desktop: {{ block.settings.text_size_desktop | default: 14 }}px;
        --countdown-text-mobile: {{ block.settings.text_size_mobile | default: 13 }}px;
      "
    >
      <div class="cart-drawer-countdown">
        <div class="cart-drawer-countdown__text rte">
          {{ block.settings.message | replace: '[time]', '<span class="cart-drawer-countdown__time" data-countdown-display>--:--</span>' }}
        </div>
      </div>
    </cart-drawer-countdown>

  {%- when 'image' -%}
    {%- if block.settings.image != blank -%}
      <div class="cart-drawer-block cart-drawer-block--image cart-drawer-block--align-{{ block.settings.alignment }}" {{ block.shopify_attributes }}
        style="{{ margin_style }}"
      >
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
        <img
          src="{{ block.settings.image | image_url: width: 800 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          style="width: {{ block.settings.image_width }}%; border-radius: {{ block.settings.corner_radius }}px;"
        >
        {%- if block.settings.link != blank -%}</a>{%- endif -%}
      </div>
    {%- endif -%}

  {%- when 'enhanced_text' -%}
    <div class="cart-drawer-block cart-drawer-block--enhanced-text cart-drawer-block--align-{{ block.settings.alignment }}" {{ block.shopify_attributes }}
      style="{{ margin_style }}"
    >
      {%- for i in (1..3) -%}
        {%- liquid
          assign text_key = 'text_' | append: i
          assign icon_key = 'icon_' | append: i
          assign icon_image_key = 'icon_image_' | append: i
          assign text_val = block.settings[text_key]
          assign icon_val = block.settings[icon_key]
          assign icon_image_val = block.settings[icon_image_key]
        -%}
        {%- if text_val != blank -%}
          <div class="cart-drawer-enhanced-text__item">
            {%- if icon_val != 'none' and icon_val != blank -%}
              <div class="cart-drawer-enhanced-text__icon">
                {%- if icon_val == 'custom' and icon_image_val != blank -%}
                  <img src="{{ icon_image_val | image_url: width: 48 }}" alt="" width="24" height="24" loading="lazy">
                {%- else -%}
                  {%- case icon_val -%}
                    {%- when 'info' -%}
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M12 16V12M12 8H12.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    {%- when 'truck' -%}
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13 16.5H3.5V7.5H16.5V10M21 14V12L19 7.5H16.5V14H21ZM21 14H23V17H21.5M16.5 17H7M3.5 17H2V14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="5" cy="17.5" r="2" stroke="currentColor" stroke-width="1.5"/><circle cx="19" cy="17.5" r="2" stroke="currentColor" stroke-width="1.5"/></svg>
                    {%- when 'shield' -%}
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 22C12 22 20 18 20 12V5L12 2L4 5V12C4 18 12 22 12 22Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- when 'gift' -%}
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="8" width="18" height="4" rx="1" stroke="currentColor" stroke-width="1.5"/><path d="M12 8V21M5 12H19V20C19 20.5523 18.5523 21 18 21H6C5.44772 21 5 20.5523 5 20V12Z" stroke="currentColor" stroke-width="1.5"/><path d="M12 8C12 8 12 5 9.5 4C7 3 6 5 7 6.5C8 8 12 8 12 8ZM12 8C12 8 12 5 14.5 4C17 3 18 5 17 6.5C16 8 12 8 12 8Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    {%- when 'returns' -%}
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 10H13C17.4183 10 21 13.5817 21 18V20M3 10L9 4M3 10L9 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- when 'lock' -%}
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M7 11V7C7 4.23858 9.23858 2 12 2C14.7614 2 17 4.23858 17 7V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    {%- when 'check' -%}
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- when 'clock' -%}
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M12 6V12L16 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                  {%- endcase -%}
                {%- endif -%}
              </div>
            {%- endif -%}
            <div class="cart-drawer-enhanced-text__content rte">
              {{ text_val }}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  {%- when 'custom_liquid' -%}
    {%- if block.settings.custom_liquid != blank -%}
      <div class="cart-drawer-block cart-drawer-block--custom-liquid" {{ block.shopify_attributes }}
        style="{{ margin_style }}"
      >
        {{ block.settings.custom_liquid }}
      </div>
    {%- endif -%}

  {%- when 'trust_badges' -%}
    <div class="cart-drawer-block cart-drawer-block--trust" {{ block.shopify_attributes }}
      style="{{ margin_style }}"
    >
      {%- if block.settings.heading != blank -%}
        <p class="cart-drawer-trust__heading">{{ block.settings.heading }}</p>
      {%- endif -%}
      <div class="cart-drawer-trust__badges">
        {%- if block.settings.image_1 != blank -%}
          <div class="cart-drawer-trust__badge">
            <img src="{{ block.settings.image_1 | image_url: width: 80 }}" alt="{{ block.settings.image_1.alt | default: 'Trust badge' | escape }}" width="40" height="40" loading="lazy">
          </div>
        {%- endif -%}
        {%- if block.settings.image_2 != blank -%}
          <div class="cart-drawer-trust__badge">
            <img src="{{ block.settings.image_2 | image_url: width: 80 }}" alt="{{ block.settings.image_2.alt | default: 'Trust badge' | escape }}" width="40" height="40" loading="lazy">
          </div>
        {%- endif -%}
        {%- if block.settings.image_3 != blank -%}
          <div class="cart-drawer-trust__badge">
            <img src="{{ block.settings.image_3 | image_url: width: 80 }}" alt="{{ block.settings.image_3.alt | default: 'Trust badge' | escape }}" width="40" height="40" loading="lazy">
          </div>
        {%- endif -%}
        {%- if block.settings.image_4 != blank -%}
          <div class="cart-drawer-trust__badge">
            <img src="{{ block.settings.image_4 | image_url: width: 80 }}" alt="{{ block.settings.image_4.alt | default: 'Trust badge' | escape }}" width="40" height="40" loading="lazy">
          </div>
        {%- endif -%}
        {%- if block.settings.image_1 == blank and block.settings.image_2 == blank and block.settings.image_3 == blank and block.settings.image_4 == blank -%}
          <div class="cart-drawer-trust__badge cart-drawer-trust__badge--icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 22C12 22 20 18 20 12V5L12 2L4 5V12C4 18 12 22 12 22Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 12L11 14L15 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>Secure</span>
          </div>
          <div class="cart-drawer-trust__badge cart-drawer-trust__badge--icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="1" y="4" width="22" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/><line x1="1" y1="10" x2="23" y2="10" stroke="currentColor" stroke-width="1.5"/></svg>
            <span>Encrypted</span>
          </div>
          <div class="cart-drawer-trust__badge cart-drawer-trust__badge--icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M7 11V7C7 4.23858 9.23858 2 12 2C14.7614 2 17 4.23858 17 7V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <span>Protected</span>
          </div>
        {%- endif -%}
      </div>
      {%- if block.settings.custom_text != blank -%}
        <p class="cart-drawer-trust__text">{{ block.settings.custom_text }}</p>
      {%- endif -%}
    </div>

  {%- when 'text' -%}
    <div class="cart-drawer-block cart-drawer-block--text" {{ block.shopify_attributes }}
      style="
        {%- if block.settings.bg_color != blank -%}--drawer-text-bg: {{ block.settings.bg_color }};{%- endif -%}
        {%- if block.settings.text_color != blank -%}--drawer-text-color: {{ block.settings.text_color }};{%- endif -%}
        {{ margin_style }}
      "
    >
      {%- if block.settings.icon != 'none' -%}
        <div class="cart-drawer-text__icon">
          {%- case block.settings.icon -%}
            {%- when 'info' -%}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M12 16V12M12 8H12.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            {%- when 'truck' -%}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13 16.5H3.5V7.5H16.5V10M21 14V12L19 7.5H16.5V14H21ZM21 14H23V17H21.5M16.5 17H7M3.5 17H2V14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="5" cy="17.5" r="2" stroke="currentColor" stroke-width="1.5"/><circle cx="19" cy="17.5" r="2" stroke="currentColor" stroke-width="1.5"/></svg>
            {%- when 'shield' -%}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 22C12 22 20 18 20 12V5L12 2L4 5V12C4 18 12 22 12 22Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- when 'gift' -%}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="8" width="18" height="4" rx="1" stroke="currentColor" stroke-width="1.5"/><path d="M12 8V21M5 12H19V20C19 20.5523 18.5523 21 18 21H6C5.44772 21 5 20.5523 5 20V12Z" stroke="currentColor" stroke-width="1.5"/><path d="M12 8C12 8 12 5 9.5 4C7 3 6 5 7 6.5C8 8 12 8 12 8ZM12 8C12 8 12 5 14.5 4C17 3 18 5 17 6.5C16 8 12 8 12 8Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            {%- when 'returns' -%}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 10H13C17.4183 10 21 13.5817 21 18V20M3 10L9 4M3 10L9 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {%- endcase -%}
        </div>
      {%- endif -%}
      <div class="cart-drawer-text__content rte">
        {{ block.settings.text }}
      </div>
    </div>

  {%- when 'payment_badges' -%}
    {%- if shop.enabled_payment_types.size > 0 -%}
      <div class="cart-drawer-block cart-drawer-block--payment cart-drawer-block--align-{{ block.settings.alignment | default: 'center' }}" {{ block.shopify_attributes }}
        style="{{ margin_style }}"
      >
        {%- if block.settings.heading != blank -%}
          <p class="cart-drawer-payment__heading">{{ block.settings.heading }}</p>
        {%- endif -%}
        <ul class="list list-payment cart-drawer-payment__list" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li class="list-payment__item">
              {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

  {%- when 'divider' -%}
    <div class="cart-drawer-block cart-drawer-block--divider" {{ block.shopify_attributes }}
      style="
        padding-top: {{ block.settings.padding_top | divided_by: 10.0 }}rem;
        padding-bottom: {{ block.settings.padding_bottom | divided_by: 10.0 }}rem;
        {{ margin_style }}
      "
    >
      {%- if block.settings.style == 'line' -%}
        <hr class="cart-drawer-divider__line">
      {%- endif -%}
    </div>

{%- endcase -%}
