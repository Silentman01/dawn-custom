{% style %}
  .rb-badge{--rb-star:#ffcc00;--rb-text:#121212;display:flex;align-items:center;flex-wrap:wrap;gap:6px}
  .rb-stars{display:flex;align-items:center;gap:1px}
  .rb-stars svg{width:16px;height:16px;fill:var(--rb-star)}
  .rb-label{font-size:13px;color:var(--rb-text);opacity:.85;line-height:1}
{% endstyle %}

