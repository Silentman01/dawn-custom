{%- liquid
  assign item_count = 0
  if text_1 != blank
    assign item_count = item_count | plus: 1
  endif
  if text_2 != blank
    assign item_count = item_count | plus: 1
  endif
  if text_3 != blank
    assign item_count = item_count | plus: 1
  endif
-%}

{% style %}
  .twi-container{display:flex;flex-direction:column;gap:0.6em;width:100%}
  .twi-container--horizontal{flex-direction:row;flex-wrap:wrap;gap:1em}
  .twi-item{display:flex;align-items:center;gap:0.5em;font-size:var(--twi-text-size,1.3rem);line-height:1.4;color:var(--twi-text-color,#121212)}
  .twi-item .material-symbols-outlined{font-size:1.4em;color:var(--twi-icon-color,#121212);line-height:1}
  .twi-item img{width:1.4em;height:1.4em;object-fit:contain;flex-shrink:0}
{% endstyle %}

{%- if item_count > 0 -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,1,0&display=swap">
<div
  class="twi-container{% if direction == 'horizontal' %} twi-container--horizontal{% endif %}"
  style="--twi-text-size:{{ text_size | default: 13 | divided_by: 10.0 }}rem;--twi-text-color:{{ text_color | default: '#121212' }};--twi-icon-color:{{ icon_color | default: '#121212' }};"
>
  {%- for i in (1..3) -%}
    {%- liquid
      case i
        when 1
          assign twi_text = text_1
          assign twi_icon = icon_1
          assign twi_custom_icon = custom_icon_1
        when 2
          assign twi_text = text_2
          assign twi_icon = icon_2
          assign twi_custom_icon = custom_icon_2
        when 3
          assign twi_text = text_3
          assign twi_icon = icon_3
          assign twi_custom_icon = custom_icon_3
      endcase
    -%}
    {%- if twi_text != blank -%}
      <div class="twi-item">
        {%- if twi_custom_icon != blank -%}
          <img src="{{ twi_custom_icon | image_url: width: 48 }}" alt="" width="24" height="24" loading="lazy">
        {%- elsif twi_icon != blank -%}
          <span class="material-symbols-outlined" aria-hidden="true">{{ twi_icon }}</span>
        {%- endif -%}
        <span>{{ twi_text }}</span>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>
{%- endif -%}