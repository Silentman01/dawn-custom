{%- liquid
  assign columns = section.settings.columns_per_row | plus: 0
  assign desktop_layout = section.settings.desktop_layout
  assign mobile_layout = section.settings.mobile_layout
  assign nav_desktop = section.settings.navigation_desktop
  assign nav_mobile = section.settings.navigation_mobile

  assign needs_scroll_desktop = false
  if desktop_layout == 'scrollable' and section.blocks.size > columns
    assign needs_scroll_desktop = true
  endif
  assign needs_scroll_mobile = false
  if mobile_layout == 'scrollable' and section.blocks.size > 1
    assign needs_scroll_mobile = true
  endif

  assign render_arrows = false
  assign render_dots = false
  if needs_scroll_desktop
    if nav_desktop == 'arrows' or nav_desktop == 'both'
      assign render_arrows = true
    endif
    if nav_desktop == 'dots' or nav_desktop == 'both'
      assign render_dots = true
    endif
  endif
  if needs_scroll_mobile
    if nav_mobile == 'arrows' or nav_mobile == 'both'
      assign render_arrows = true
    endif
    if nav_mobile == 'dots' or nav_mobile == 'both'
      assign render_dots = true
    endif
  endif
-%}

{%- style -%}
  .testimonials-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    --testimonials-columns: {{ columns }};
    {% if section.settings.use_custom_colors and section.settings.custom_bg_color != blank %}
      --testimonials-bg: {{ section.settings.custom_bg_color }};
    {% endif %}
    {% if section.settings.use_custom_colors and section.settings.custom_text_color != blank %}
      --testimonials-text: {{ section.settings.custom_text_color }};
    {% endif %}
    {% if section.settings.use_custom_colors and section.settings.custom_card_bg != blank %}
      --testimonials-card-bg: {{ section.settings.custom_card_bg }};
    {% endif %}
    {% if section.settings.use_custom_colors and section.settings.custom_card_text != blank %}
      --testimonials-card-text: {{ section.settings.custom_card_text }};
    {% endif %}
  }
  @media screen and (min-width: 750px) {
    .testimonials-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div
    class="testimonials-section testimonials-{{ section.id }} color-{{ section.settings.color_scheme }}"
    data-testimonials-section="{{ section.id }}"
    data-columns="{{ columns }}"
    data-desktop-layout="{{ desktop_layout }}"
    data-mobile-layout="{{ mobile_layout }}"
    data-nav-desktop="{{ nav_desktop }}"
    data-nav-mobile="{{ nav_mobile }}"
  >
    <div class="page-width">
      {%- if section.settings.title != blank -%}
        <div class="testimonials__header testimonials__align--{{ section.settings.heading_alignment }}">
          <h2 class="testimonials__title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        </div>
      {%- endif -%}

      <div class="testimonials__wrapper">
        <div class="testimonials__track-container" data-testimonials-slider="{{ section.id }}">
          <div class="testimonials__track
            {%- if mobile_layout == 'stacked' %} testimonials__track--stacked-mobile{% endif %}
            {%- if desktop_layout == 'stacked' %} testimonials__track--stacked-desktop{% endif %}"
          >
            {%- for block in section.blocks -%}
              <div class="testimonials__card" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <div class="testimonials__image">
                    <img
                      src="{{ block.settings.image | image_url: width: 600 }}"
                      alt="{{ block.settings.image.alt | escape }}"
                      width="600"
                      height="{{ 600 | divided_by: block.settings.image.aspect_ratio | round }}"
                      loading="lazy"
                    >
                  </div>
                {%- endif -%}

                {%- if block.settings.show_stars -%}
                  <div class="testimonials__stars" aria-label="{{ block.settings.stars }} out of 5 stars">
                    {%- for i in (1..5) -%}
                      <svg class="testimonials__star {% if i <= block.settings.stars %}testimonials__star--filled{% endif %}" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" {% if i <= block.settings.stars %}fill="currentColor"{% else %}fill="none" stroke="currentColor" stroke-width="1.5"{% endif %}/>
                      </svg>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="testimonials__text rte">{{ block.settings.text }}</div>
                {%- endif -%}

                <div class="testimonials__author">
                  {%- if block.settings.author_image != blank -%}
                    <div class="testimonials__author-image">
                      <img
                        src="{{ block.settings.author_image | image_url: width: 80, height: 80, crop: 'center' }}"
                        alt="{{ block.settings.author_name | strip_html | escape }}"
                        width="40"
                        height="40"
                        loading="lazy"
                      >
                    </div>
                  {%- endif -%}
                  <div class="testimonials__author-info">
                    {%- if block.settings.author_name != blank -%}
                      <span class="testimonials__author-name inline-richtext">{{ block.settings.author_name }}</span>
                    {%- endif -%}
                    {%- if block.settings.show_verified -%}
                      <span class="testimonials__verified">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 1l3.09 2.34L18.5 3l1.28 3.17L22 9.27l-1.64 3.07.36 3.48-3.2 1.43L15.09 20 12 19.09 8.91 20l-2.53-2.75-3.2-1.43.36-3.48L1.9 9.27l2.22-3.1L5.5 3l3.41.34L12 1zm-1.41 14.59l7.07-7.07-1.41-1.41-5.66 5.66-2.83-2.83-1.41 1.41 4.24 4.24z"/></svg>
                        Verified Purchase
                      </span>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        {%- if render_arrows -%}
          <button class="testimonials__arrow testimonials__arrow--prev" aria-label="Previous testimonial" data-testimonials-prev>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button class="testimonials__arrow testimonials__arrow--next" aria-label="Next testimonial" data-testimonials-next>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- endif -%}
      </div>

      {%- if render_dots -%}
        <div class="testimonials__dots" data-testimonials-dots>
          {%- for block in section.blocks -%}
            <button class="testimonials__dot {% if forloop.first %}testimonials__dot--active{% endif %}" aria-label="Go to testimonial {{ forloop.index }}" data-testimonials-dot="{{ forloop.index0 }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <script>
    (function() {
      var root = document.querySelector('[data-testimonials-section="{{ section.id }}"]');
      if (!root) return;
      var container = root.querySelector('[data-testimonials-slider="{{ section.id }}"]');
      var track = container.querySelector('.testimonials__track');
      var cards = track.querySelectorAll('.testimonials__card');
      if (cards.length <= 1) return;

      var desktopLayout = root.getAttribute('data-desktop-layout');
      var mobileLayout = root.getAttribute('data-mobile-layout');
      var navDesktop = root.getAttribute('data-nav-desktop');
      var navMobile = root.getAttribute('data-nav-mobile');

      var prevBtn = root.querySelector('[data-testimonials-prev]');
      var nextBtn = root.querySelector('[data-testimonials-next]');
      var dotsContainer = root.querySelector('[data-testimonials-dots]');
      var dots = root.querySelectorAll('[data-testimonials-dot]');
      var currentIndex = 0;

      function isMobile() {
        return window.innerWidth < 750;
      }

      function isStacked() {
        if (isMobile()) return mobileLayout === 'stacked';
        return desktopLayout === 'stacked';
      }

      function currentNav() {
        return isMobile() ? navMobile : navDesktop;
      }

      function getVisibleCount() {
        if (isStacked()) return cards.length;
        var trackWidth = track.offsetWidth;
        var cardWidth = cards[0].offsetWidth;
        var gap = parseFloat(getComputedStyle(track).gap) || 0;
        return Math.max(1, Math.floor((trackWidth + gap) / (cardWidth + gap)));
      }

      function updateArrowBoundary() {
        if (!prevBtn || !nextBtn) return;
        var scrollLeft = track.scrollLeft;
        var maxScroll = track.scrollWidth - track.offsetWidth;
        var atStart = scrollLeft <= 2;
        var atEnd = scrollLeft >= maxScroll - 2;
        prevBtn.classList.toggle('testimonials__arrow--hidden', atStart);
        nextBtn.classList.toggle('testimonials__arrow--hidden', atEnd);
      }

      function updateNavVisibility() {
        var nav = currentNav();
        var canScroll = !isStacked() && cards.length > getVisibleCount();
        var showArrows = canScroll && (nav === 'arrows' || nav === 'both');
        var showDots = canScroll && (nav === 'dots' || nav === 'both');

        if (prevBtn) prevBtn.style.display = showArrows ? '' : 'none';
        if (nextBtn) nextBtn.style.display = showArrows ? '' : 'none';
        if (dotsContainer) dotsContainer.style.display = showDots ? '' : 'none';

        if (showArrows) updateArrowBoundary();
      }

      function scrollToIndex(index) {
        if (isStacked()) return;
        var maxIndex = cards.length - getVisibleCount();
        if (maxIndex < 0) maxIndex = 0;
        if (index < 0) index = 0;
        if (index > maxIndex) index = maxIndex;
        currentIndex = index;

        var card = cards[index];
        track.scrollTo({ left: card.offsetLeft, behavior: 'smooth' });
        updateDots();
      }

      function updateDots() {
        dots.forEach(function(dot, i) {
          dot.classList.toggle('testimonials__dot--active', i === currentIndex);
        });
      }

      function onScroll() {
        if (isStacked()) return;
        var scrollLeft = track.scrollLeft;
        var closest = 0;
        var minDist = Infinity;
        cards.forEach(function(card, i) {
          var dist = Math.abs(card.offsetLeft - scrollLeft);
          if (dist < minDist) {
            minDist = dist;
            closest = i;
          }
        });
        currentIndex = closest;
        updateDots();
        updateArrowBoundary();
      }

      var scrollTimer;
      track.addEventListener('scroll', function() {
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(onScroll, 80);
      });

      if (prevBtn) {
        prevBtn.addEventListener('click', function() { scrollToIndex(currentIndex - 1); });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function() { scrollToIndex(currentIndex + 1); });
      }

      dots.forEach(function(dot) {
        dot.addEventListener('click', function() {
          scrollToIndex(parseInt(dot.getAttribute('data-testimonials-dot')));
        });
      });

      updateNavVisibility();
      var resizeTimer;
      window.addEventListener('resize', function() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(updateNavVisibility, 100);
      });
    })();
  </script>
{%- endif -%}

{% style %}
  .testimonials-section {
    background-color: var(--testimonials-bg, rgb(var(--color-background)));
    color: var(--testimonials-text, rgb(var(--color-foreground)));
  }

  .testimonials__header {
    margin-bottom: 3rem;
  }

  .testimonials__title {
    margin: 0;
  }

  .testimonials__align--left {
    text-align: left;
  }

  .testimonials__align--center {
    text-align: center;
  }

  .testimonials__align--right {
    text-align: right;
  }

  .testimonials__wrapper {
    position: relative;
  }

  .testimonials__track {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .testimonials__track::-webkit-scrollbar {
    display: none;
  }

  .testimonials__card {
    flex: 0 0 100%;
    scroll-snap-align: start;
    background-color: var(--testimonials-card-bg, rgb(var(--color-background)));
    color: var(--testimonials-card-text, rgb(var(--color-foreground)));
    border-radius: 1.2rem;
    padding: 2rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(var(--color-foreground), 0.08);
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .testimonials__card .testimonials__text,
  .testimonials__card .testimonials__text p,
  .testimonials__card .testimonials__author-name {
    color: inherit;
  }

  /* Stacked mobile layout */
  @media screen and (max-width: 749px) {
    .testimonials__track--stacked-mobile {
      flex-wrap: wrap;
      overflow-x: visible;
      scroll-snap-type: none;
    }

    .testimonials__track--stacked-mobile .testimonials__card {
      flex: 0 0 100%;
    }
  }

  /* Desktop column sizing */
  @media screen and (min-width: 750px) {
    .testimonials__card {
      flex: 0 0 calc((100% - 2rem * (var(--testimonials-columns) - 1)) / var(--testimonials-columns));
    }

    .testimonials__track--stacked-desktop {
      flex-wrap: wrap;
      overflow-x: visible;
      scroll-snap-type: none;
    }
  }

  .testimonials__image {
    border-radius: 0.8rem;
    overflow: hidden;
    margin: -2rem -2rem 0;
  }

  .testimonials__image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .testimonials__stars {
    display: flex;
    gap: 0.2rem;
    color: #f5a623;
  }

  .testimonials__text {
    margin: 0;
    line-height: 1.6;
  }

  .testimonials__text p {
    margin: 0 0 0.8rem;
  }

  .testimonials__text p:last-child {
    margin-bottom: 0;
  }

  .testimonials__author {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.4rem;
  }

  .testimonials__author-image {
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    overflow: hidden;
  }

  .testimonials__author-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonials__author-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .testimonials__author-name {
    font-weight: 600;
    font-size: 1.4rem;
    line-height: 1.3;
  }

  .testimonials__verified {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 1.1rem;
    color: #1a73e8;
    font-weight: 500;
    white-space: nowrap;
  }

  .testimonials__verified svg {
    width: 14px;
    height: 14px;
    fill: #1a73e8;
    flex-shrink: 0;
  }

  /* Arrows — sit outside the cards */
  .testimonials__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: 50%;
    width: 4.2rem;
    height: 4.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    transition: opacity 0.25s ease, background-color 0.2s;
  }

  .testimonials__arrow:hover {
    background-color: rgba(var(--color-foreground), 0.05);
  }

  .testimonials__arrow--hidden {
    opacity: 0;
    pointer-events: none;
  }

  .testimonials__arrow--prev {
    left: -5.2rem;
  }

  .testimonials__arrow--next {
    right: -5.2rem;
  }

  /* On narrower desktops where arrows would go outside viewport, tuck them in slightly */
  @media screen and (min-width: 750px) and (max-width: 1099px) {
    .testimonials__arrow--prev {
      left: -1rem;
    }

    .testimonials__arrow--next {
      right: -1rem;
    }
  }

  @media screen and (max-width: 749px) {
    .testimonials__arrow--prev {
      left: -0.5rem;
    }

    .testimonials__arrow--next {
      right: -0.5rem;
    }
  }

  /* Dots */
  .testimonials__dots {
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .testimonials__dot {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 1px solid rgba(var(--color-foreground), 0.3);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .testimonials__dot--active {
    background-color: rgb(var(--color-foreground));
    border-color: rgb(var(--color-foreground));
  }

  .testimonials__dot:hover {
    border-color: rgb(var(--color-foreground));
  }
{% endstyle %}

{% schema %}
{
  "name": "Testimonials",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "What our customers say",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Heading alignment"
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "select",
      "id": "columns_per_row",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "3",
      "label": "Columns per row"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "options": [
        {
          "value": "scrollable",
          "label": "Scrollable"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        }
      ],
      "default": "scrollable",
      "label": "Desktop layout"
    },
    {
      "type": "select",
      "id": "navigation_desktop",
      "options": [
        {
          "value": "dots",
          "label": "Dots"
        },
        {
          "value": "arrows",
          "label": "Arrows"
        },
        {
          "value": "both",
          "label": "Dots and arrows"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "arrows",
      "label": "Desktop navigation"
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "options": [
        {
          "value": "scrollable",
          "label": "Scrollable"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        }
      ],
      "default": "scrollable",
      "label": "Mobile layout"
    },
    {
      "type": "select",
      "id": "navigation_mobile",
      "options": [
        {
          "value": "dots",
          "label": "Dots"
        },
        {
          "value": "arrows",
          "label": "Arrows"
        },
        {
          "value": "both",
          "label": "Dots and arrows"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "dots",
      "label": "Mobile navigation"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_custom_colors",
      "default": false,
      "label": "Use custom colors"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Section background"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Section text"
    },
    {
      "type": "color",
      "id": "custom_card_bg",
      "label": "Card background"
    },
    {
      "type": "color",
      "id": "custom_card_text",
      "label": "Card text"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px",
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px",
      "label": "Bottom padding"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "author_name",
          "default": "John D.",
          "label": "Author name"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author image",
          "info": "Hidden if empty"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>This product exceeded my expectations. The quality is outstanding and customer service was excellent.</p>",
          "label": "Testimonial text"
        },
        {
          "type": "checkbox",
          "id": "show_stars",
          "default": true,
          "label": "Show stars"
        },
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Star rating"
        },
        {
          "type": "checkbox",
          "id": "show_verified",
          "default": true,
          "label": "Show verified purchase badge"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional image displayed at top of card"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
