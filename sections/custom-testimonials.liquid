{%- style -%}
  .testimonials-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    {% if section.settings.use_custom_colors and section.settings.custom_bg_color != blank %}
      --testimonials-bg: {{ section.settings.custom_bg_color }};
    {% endif %}
    {% if section.settings.use_custom_colors and section.settings.custom_text_color != blank %}
      --testimonials-text: {{ section.settings.custom_text_color }};
    {% endif %}
    {% if section.settings.use_custom_colors and section.settings.custom_card_bg != blank %}
      --testimonials-card-bg: {{ section.settings.custom_card_bg }};
    {% endif %}
    {% if section.settings.use_custom_colors and section.settings.custom_card_text != blank %}
      --testimonials-card-text: {{ section.settings.custom_card_text }};
    {% endif %}
  }
  @media screen and (min-width: 750px) {
    .testimonials-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div class="testimonials-section testimonials-{{ section.id }} color-{{ section.settings.color_scheme }}">
    <div class="page-width">
      {%- if section.settings.title != blank -%}
        <div class="testimonials__header testimonials__align--{{ section.settings.heading_alignment }}">
          <h2 class="testimonials__title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        </div>
      {%- endif -%}

      <div class="testimonials__wrapper" data-testimonials-slider="{{ section.id }}">
        <div class="testimonials__track">
          {%- for block in section.blocks -%}
            <div class="testimonials__card" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <div class="testimonials__image">
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    width="600"
                    height="{{ 600 | divided_by: block.settings.image.aspect_ratio | round }}"
                    loading="lazy"
                  >
                </div>
              {%- endif -%}

              {%- if block.settings.show_stars -%}
                <div class="testimonials__stars" aria-label="{{ block.settings.stars }} out of 5 stars">
                  {%- for i in (1..5) -%}
                    <svg class="testimonials__star {% if i <= block.settings.stars %}testimonials__star--filled{% endif %}" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" {% if i <= block.settings.stars %}fill="currentColor"{% else %}fill="none" stroke="currentColor" stroke-width="1.5"{% endif %}/>
                    </svg>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="testimonials__text rte">{{ block.settings.text }}</div>
              {%- endif -%}

              <div class="testimonials__author">
                {%- if block.settings.author_image != blank -%}
                  <div class="testimonials__author-image">
                    <img
                      src="{{ block.settings.author_image | image_url: width: 80, height: 80, crop: 'center' }}"
                      alt="{{ block.settings.author_name | strip_html | escape }}"
                      width="40"
                      height="40"
                      loading="lazy"
                    >
                  </div>
                {%- endif -%}
                <div class="testimonials__author-info">
                  {%- if block.settings.author_name != blank -%}
                    <span class="testimonials__author-name inline-richtext">{{ block.settings.author_name }}</span>
                  {%- endif -%}
                  {%- if block.settings.show_verified -%}
                    <span class="testimonials__verified">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      Verified purchase
                    </span>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.show_arrows and section.blocks.size > 1 -%}
          <button class="testimonials__arrow testimonials__arrow--prev" aria-label="Previous testimonial" data-testimonials-prev>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button class="testimonials__arrow testimonials__arrow--next" aria-label="Next testimonial" data-testimonials-next>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- endif -%}
      </div>

      {%- if section.settings.show_dots and section.blocks.size > 1 -%}
        <div class="testimonials__dots" data-testimonials-dots>
          {%- for block in section.blocks -%}
            <button class="testimonials__dot {% if forloop.first %}testimonials__dot--active{% endif %}" aria-label="Go to testimonial {{ forloop.index }}" data-testimonials-dot="{{ forloop.index0 }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <script>
    (function() {
      var section = document.querySelector('[data-testimonials-slider="{{ section.id }}"]');
      if (!section) return;
      var track = section.querySelector('.testimonials__track');
      var cards = track.querySelectorAll('.testimonials__card');
      if (cards.length <= 1) return;

      var prevBtn = section.querySelector('[data-testimonials-prev]');
      var nextBtn = section.querySelector('[data-testimonials-next]');
      var dots = section.closest('.testimonials-section').querySelectorAll('[data-testimonials-dot]');
      var currentIndex = 0;

      function getVisibleCount() {
        var trackWidth = track.offsetWidth;
        var cardWidth = cards[0].offsetWidth;
        var gap = parseFloat(getComputedStyle(track).gap) || 0;
        return Math.floor((trackWidth + gap) / (cardWidth + gap));
      }

      function scrollToIndex(index) {
        var maxIndex = cards.length - getVisibleCount();
        if (maxIndex < 0) maxIndex = 0;
        if (index < 0) index = 0;
        if (index > maxIndex) index = maxIndex;
        currentIndex = index;

        var card = cards[index];
        track.scrollTo({ left: card.offsetLeft, behavior: 'smooth' });
        updateDots();
      }

      function updateDots() {
        dots.forEach(function(dot, i) {
          dot.classList.toggle('testimonials__dot--active', i === currentIndex);
        });
      }

      function onScroll() {
        var scrollLeft = track.scrollLeft;
        var closest = 0;
        var minDist = Infinity;
        cards.forEach(function(card, i) {
          var dist = Math.abs(card.offsetLeft - scrollLeft);
          if (dist < minDist) {
            minDist = dist;
            closest = i;
          }
        });
        currentIndex = closest;
        updateDots();
      }

      var scrollTimer;
      track.addEventListener('scroll', function() {
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(onScroll, 100);
      });

      if (prevBtn) {
        prevBtn.addEventListener('click', function() { scrollToIndex(currentIndex - 1); });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function() { scrollToIndex(currentIndex + 1); });
      }

      dots.forEach(function(dot) {
        dot.addEventListener('click', function() {
          scrollToIndex(parseInt(dot.getAttribute('data-testimonials-dot')));
        });
      });
    })();
  </script>
{%- endif -%}

{% style %}
  .testimonials-section {
    background-color: var(--testimonials-bg, rgb(var(--color-background)));
    color: var(--testimonials-text, rgb(var(--color-foreground)));
  }

  .testimonials__header {
    margin-bottom: 3rem;
  }

  .testimonials__title {
    margin: 0;
  }

  .testimonials__align--left {
    text-align: left;
  }

  .testimonials__align--center {
    text-align: center;
  }

  .testimonials__align--right {
    text-align: right;
  }

  .testimonials__wrapper {
    position: relative;
  }

  .testimonials__track {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 0.5rem;
  }

  .testimonials__track::-webkit-scrollbar {
    display: none;
  }

  .testimonials__card {
    flex: 0 0 calc(100% - 2rem);
    scroll-snap-align: start;
    background-color: var(--testimonials-card-bg, rgb(var(--color-background)));
    color: var(--testimonials-card-text, rgb(var(--color-foreground)));
    border-radius: 1.2rem;
    padding: 2rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(var(--color-foreground), 0.08);
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .testimonials__card .testimonials__text,
  .testimonials__card .testimonials__text p,
  .testimonials__card .testimonials__author-name {
    color: inherit;
  }

  @media screen and (min-width: 750px) {
    .testimonials__card {
      flex: 0 0 calc(50% - 1rem);
    }
  }

  @media screen and (min-width: 990px) {
    .testimonials__card {
      flex: 0 0 calc(33.333% - 1.34rem);
      padding: 2.4rem;
    }
  }

  .testimonials__image {
    border-radius: 0.8rem;
    overflow: hidden;
    margin: -2rem -2rem 0;
  }

  @media screen and (min-width: 990px) {
    .testimonials__image {
      margin: -2.4rem -2.4rem 0;
    }
  }

  .testimonials__image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .testimonials__stars {
    display: flex;
    gap: 0.2rem;
    color: #f5a623;
  }

  .testimonials__text {
    margin: 0;
    line-height: 1.6;
  }

  .testimonials__text p {
    margin: 0 0 0.8rem;
  }

  .testimonials__text p:last-child {
    margin-bottom: 0;
  }

  .testimonials__author {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.4rem;
  }

  .testimonials__author-image {
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    overflow: hidden;
  }

  .testimonials__author-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonials__author-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .testimonials__author-name {
    font-weight: 600;
    font-size: 1.4rem;
    line-height: 1.3;
  }

  .testimonials__verified {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 1.2rem;
    opacity: 0.65;
  }

  .testimonials__verified svg {
    flex-shrink: 0;
  }

  /* Arrows */
  .testimonials__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: 50%;
    width: 4rem;
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    transition: opacity 0.2s, background-color 0.2s;
  }

  .testimonials__arrow:hover {
    background-color: rgba(var(--color-foreground), 0.05);
  }

  .testimonials__arrow--prev {
    left: -1rem;
  }

  .testimonials__arrow--next {
    right: -1rem;
  }

  @media screen and (max-width: 749px) {
    .testimonials__arrow {
      display: none;
    }
  }

  /* Dots */
  .testimonials__dots {
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .testimonials__dot {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 1px solid rgba(var(--color-foreground), 0.3);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .testimonials__dot--active {
    background-color: rgb(var(--color-foreground));
    border-color: rgb(var(--color-foreground));
  }

  .testimonials__dot:hover {
    border-color: rgb(var(--color-foreground));
  }
{% endstyle %}

{% schema %}
{
  "name": "Testimonials",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "What our customers say",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Heading alignment"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "default": true,
      "label": "Show pagination dots"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "default": true,
      "label": "Show arrows"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_custom_colors",
      "default": false,
      "label": "Use custom colors"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Section background"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Section text"
    },
    {
      "type": "color",
      "id": "custom_card_bg",
      "label": "Card background"
    },
    {
      "type": "color",
      "id": "custom_card_text",
      "label": "Card text"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px",
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px",
      "label": "Bottom padding"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "author_name",
          "default": "John D.",
          "label": "Author name"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author image",
          "info": "Hidden if empty"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>This product exceeded my expectations. The quality is outstanding and customer service was excellent.</p>",
          "label": "Testimonial text"
        },
        {
          "type": "checkbox",
          "id": "show_stars",
          "default": true,
          "label": "Show stars"
        },
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Star rating"
        },
        {
          "type": "checkbox",
          "id": "show_verified",
          "default": true,
          "label": "Show verified purchase badge"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional image displayed at top of card"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "author_name": "Sarah M.",
            "text": "<p>Absolutely love this product! It arrived quickly and the quality is amazing. Would definitely recommend to friends.</p>",
            "stars": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "author_name": "James K.",
            "text": "<p>Great customer service and fast shipping. The product looks even better in person than in the photos.</p>",
            "stars": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "author_name": "Emily R.",
            "text": "<p>This is my third purchase from this store. Consistently high quality and fair prices. Highly recommend!</p>",
            "stars": 4
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "author_name": "Michael T.",
            "text": "<p>Exceeded all my expectations. The attention to detail is remarkable. Will be a returning customer for sure.</p>",
            "stars": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
