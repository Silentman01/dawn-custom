{%- style -%}
  .nl-steps-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  .nl-steps-{{ section.id }} .nl-steps__heading {
    text-align: center;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 3.2rem;
    color: {{ section.settings.heading_color }};
  }
  .nl-steps-{{ section.id }} .nl-steps__heading em { font-style: italic; }
  .nl-steps-{{ section.id }} .nl-steps__viewport { overflow: visible; }
  .nl-steps-{{ section.id }} .nl-steps__track {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
    gap: 2rem;
  }
  .nl-steps-{{ section.id }} .nl-steps__item {
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: 2.4rem 1.6rem;
    text-align: center;
  }
  .nl-steps-{{ section.id }} .nl-steps__img {
    width: {{ section.settings.circle_size }}px;
    height: {{ section.settings.circle_size }}px;
    max-width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    display: block;
    margin: 0 auto 1.2rem;
  }
  .nl-steps-{{ section.id }} .nl-steps__caption {
    font-size: {{ section.settings.caption_size }}px;
    line-height: 1.35;
    margin: 0 auto;
    max-width: 26rem;
    color: {{ section.settings.text_color }};
  }
  .nl-steps-{{ section.id }} .nl-steps__caption p { margin: 0; }
  .nl-steps-{{ section.id }} .nl-steps__caption strong { font-weight: 700; }
  .nl-steps-{{ section.id }} .nl-steps__dots { display: none; }
  @media screen and (max-width: 749px) {
    .nl-steps-{{ section.id }} .nl-steps__viewport { overflow: hidden; }
    .nl-steps-{{ section.id }} .nl-steps__track {
      display: flex;
      transition: transform 0.45s ease;
    }
    .nl-steps-{{ section.id }} .nl-steps__item {
      flex: 0 0 100%;
      min-width: 0;
    }
    .nl-steps-{{ section.id }} .nl-steps__dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.8rem;
      margin-top: 1.8rem;
    }
    .nl-steps-{{ section.id }} .nl-steps__dot {
      width: 9px;
      height: 9px;
      padding: 0;
      border: none;
      border-radius: 50%;
      background: rgba(0,0,0,0.18);
      cursor: pointer;
      transition: transform 0.2s, background 0.2s;
    }
    .nl-steps-{{ section.id }} .nl-steps__dot.is-active {
      background: {{ section.settings.dot_color }};
      transform: scale(1.25);
    }
  }
{%- endstyle -%}

<div class="nl-steps-{{ section.id }}" id="NlSteps-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="nl-steps__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="nl-steps__viewport">
      <div class="nl-steps__track" data-nlsteps-track>
        {%- for block in section.blocks -%}
          <div class="nl-steps__item" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img class="nl-steps__img" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.caption | strip_html | escape }}" width="{{ section.settings.circle_size }}" height="{{ section.settings.circle_size }}" loading="lazy">
            {%- else -%}
              <div class="nl-steps__img">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <div class="nl-steps__caption rte">{{ block.settings.caption }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
    <div class="nl-steps__dots" data-nlsteps-dots></div>
  </div>
</div>

{%- if section.blocks.size > 1 -%}
  <script>
    (function () {
      var root = document.getElementById('NlSteps-{{ section.id }}');
      if (!root) return;
      var track = root.querySelector('[data-nlsteps-track]');
      var dotsWrap = root.querySelector('[data-nlsteps-dots]');
      var total = track.children.length;
      var idx = 0;
      var interval = {{ section.settings.autoplay_interval | default: 4.0 | times: 1000.0 | round }};
      var timer = null;
      function isMobile() { return window.matchMedia('(max-width: 749px)').matches; }
      /* dots */
      var dots = [];
      for (var i = 0; i < total; i++) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'nl-steps__dot';
        b.setAttribute('aria-label', 'Étape ' + (i + 1));
        (function (n) { b.addEventListener('click', function () { go(n); restart(); }); })(i);
        dotsWrap.appendChild(b);
        dots.push(b);
      }
      function updateDots() { for (var i = 0; i < dots.length; i++) dots[i].classList.toggle('is-active', i === idx); }
      function go(i) {
        idx = (i + total) % total;
        track.style.transform = isMobile() ? ('translateX(-' + idx * 100 + '%)') : 'none';
        updateDots();
      }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function start() { stop(); if (isMobile()) timer = setInterval(function () { go(idx + 1); }, interval); }
      function restart() { stop(); start(); }
      go(0);
      start();
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      /* touch swipe */
      var x0 = null;
      track.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; stop(); }, { passive: true });
      track.addEventListener('touchend', function (e) {
        if (x0 === null) return;
        var dx = e.changedTouches[0].clientX - x0;
        if (dx < -40) go(idx + 1);
        else if (dx > 40) go(idx - 1);
        x0 = null;
        start();
      });
      /* keep layout correct across breakpoint changes */
      window.addEventListener('resize', function () {
        if (!isMobile()) { track.style.transform = 'none'; stop(); }
        else { go(idx); start(); }
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "NL Steps",
  "tag": "section",
  "class": "section-nl-steps",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "3 étapes pour des ongles parfaits" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 48, "step": 2, "unit": "px", "default": 34 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1e1e1e" },
    { "type": "color", "id": "text_color", "label": "Caption color", "default": "#1e1e1e" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#ffffff" },
    { "type": "header", "content": "Cards" },
    { "type": "color", "id": "card_bg_color", "label": "Card background", "default": "#fff6fb" },
    { "type": "color", "id": "card_border_color", "label": "Card border", "default": "#ffe4f0" },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "circle_size", "label": "Image size", "min": 100, "max": 320, "step": 10, "unit": "px", "default": 200 },
    { "type": "range", "id": "caption_size", "label": "Caption size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Mobile carousel" },
    { "type": "range", "id": "autoplay_interval", "label": "Auto-swipe interval (mobile)", "min": 1, "max": 10, "step": 0.5, "unit": "s", "default": 4 },
    { "type": "color", "id": "dot_color", "label": "Active dot color", "default": "#c42e62" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "inline_richtext", "id": "caption", "label": "Caption", "default": "Appliquez une <strong>base coat</strong>" }
      ]
    }
  ],
  "presets": [
    { "name": "NL Steps", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] }
  ]
}
{% endschema %}
