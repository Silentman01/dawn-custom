{%- liquid
  assign type = section.settings.slider_type
  assign autoplay = section.settings.autoplay
  assign speed = section.settings.autoplay_speed
  assign d_slides = section.settings.slides_desktop
  assign d_gap = section.settings.desktop_spacing
  assign d_radius = section.settings.desktop_border_radius
  assign m_slides = section.settings.slides_mobile
  assign m_gap = section.settings.mobile_spacing
  assign m_radius = section.settings.mobile_border_radius
  assign clone_count = d_slides
  if m_slides > clone_count
    assign clone_count = m_slides
  endif
-%}

{%- style -%}
  .ms-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    --ms-d-radius: {{ d_radius }}px;
    --ms-m-radius: {{ m_radius }}px;
    --ms-d-gap: {{ d_gap }}px;
    --ms-m-gap: {{ m_gap }}px;
    --ms-d-slides: {{ d_slides }};
    --ms-m-slides: {{ m_slides }};
    {% if section.settings.use_custom_colors and section.settings.custom_bg_color != blank %}
      --ms-bg: {{ section.settings.custom_bg_color }};
    {% endif %}
    {% if section.settings.use_custom_colors and section.settings.custom_text_color != blank %}
      --ms-text: {{ section.settings.custom_text_color }};
    {% endif %}
  }
  @media screen and (min-width: 750px) {
    .ms-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div
    class="ms ms-{{ section.id }} color-{{ section.settings.color_scheme }}"
    data-ms="{{ section.id }}"
    data-type="{{ type }}"
    data-autoplay="{{ autoplay }}"
    data-speed="{{ speed }}"
    data-d-slides="{{ d_slides }}"
    data-m-slides="{{ m_slides }}"
    data-d-gap="{{ d_gap }}"
    data-m-gap="{{ m_gap }}"
    data-clone-count="{{ clone_count }}"
    data-d-arrows="{{ section.settings.desktop_arrows }}"
    data-m-arrows="{{ section.settings.mobile_arrows }}"
    data-d-dots="{{ section.settings.desktop_dots }}"
    data-m-dots="{{ section.settings.mobile_dots }}"
  >
    {%- if section.settings.title != blank -%}
      <div class="page-width">
        <div class="ms__header ms__align--{{ section.settings.heading_alignment }}">
          <h2 class="ms__title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        </div>
      </div>
    {%- endif -%}

    <div class="ms__container {% if section.settings.desktop_full_width %}ms__container--d-full{% endif %} {% if section.settings.mobile_full_width %}ms__container--m-full{% endif %}">
      <div class="ms__wrapper">
        <div class="ms__viewport">
          <div class="ms__track" data-ms-track>
            {%- for block in section.blocks -%}
              <div class="ms__slide" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="ms__slide-link">{%- endif -%}
                <div class="ms__slide-inner">
                  {%- if block.type == 'video_slide' and block.settings.video != blank -%}
                    {{ block.settings.video | video_tag:
                      autoplay: block.settings.video_autoplay,
                      loop: block.settings.video_loop,
                      muted: true,
                      controls: block.settings.show_controls,
                      playsinline: true,
                      image_size: '1100x'
                    }}
                  {%- elsif block.type == 'image_slide' and block.settings.image != blank -%}
                    {%- assign img_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round -%}
                    {{
                      block.settings.image
                      | image_url: width: 1800
                      | image_tag:
                        loading: 'lazy',
                        widths: '375, 550, 750, 1100, 1500, 1800',
                        sizes: '(min-width: 750px) calc(100vw / var(--ms-d-slides, 3)), 100vw'
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                {%- if block.settings.description != blank -%}
                  <div class="ms__desc rte">{{ block.settings.description }}</div>
                {%- endif -%}
                {%- if block.settings.link != blank -%}</a>{%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

        <button class="ms__arrow ms__arrow--prev ms__arrow--hidden" aria-label="Previous slide" data-ms-prev>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="ms__arrow ms__arrow--next" aria-label="Next slide" data-ms-next>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <div class="ms__dots" data-ms-dots></div>
      </div>
    </div>
  </div>

  <script>
    (function(){
      var root = document.querySelector('[data-ms="{{ section.id }}"]');
      if (!root) return;

      var type = root.dataset.type;
      var doAutoplay = root.dataset.autoplay === 'true';
      var speed = parseFloat(root.dataset.speed) * 1000;
      var cloneN = parseInt(root.dataset.cloneCount);

      var track = root.querySelector('[data-ms-track]');
      var origSlides = Array.from(track.children);
      var realCount = origSlides.length;
      if (realCount === 0) return;

      var prevBtn = root.querySelector('[data-ms-prev]');
      var nextBtn = root.querySelector('[data-ms-next]');
      var dotsWrap = root.querySelector('[data-ms-dots]');

      var current = 0;
      var sw = 0; // slide width
      var gap = 0;
      var transitioning = false;
      var apTimer = null;
      var allSlides;

      function mob() { return window.innerWidth < 750; }
      function pp() { return mob() ? parseInt(root.dataset.mSlides) : parseInt(root.dataset.dSlides); }
      function gg() { return mob() ? parseInt(root.dataset.mGap) : parseInt(root.dataset.dGap); }

      function init() {
        if (type === 'loop' && realCount > 1) setupLoop();
        if (type === 'fade') setupFade();
        allSlides = Array.from(track.children);
        layout();
        buildDots();
        bind();
        if (doAutoplay && realCount > 1) startAP();
      }

      function setupLoop() {
        var n = Math.min(cloneN, realCount);
        for (var i = realCount - 1; i >= realCount - n; i--) {
          var c = origSlides[i].cloneNode(true);
          c.classList.add('is-clone');
          c.querySelectorAll('[id]').forEach(function(el){ el.removeAttribute('id'); });
          track.insertBefore(c, track.firstChild);
        }
        for (var i = 0; i < n; i++) {
          var c = origSlides[i].cloneNode(true);
          c.classList.add('is-clone');
          c.querySelectorAll('[id]').forEach(function(el){ el.removeAttribute('id'); });
          track.appendChild(c);
        }
      }

      function setupFade() {
        track.classList.add('ms__track--fade');
        origSlides[0].classList.add('is-active');
      }

      function layout() {
        allSlides = Array.from(track.children);
        var p = pp();
        gap = gg();
        var vw = root.querySelector('.ms__viewport').offsetWidth;
        sw = (vw - gap * (p - 1)) / p;
        allSlides.forEach(function(s){ s.style.width = sw + 'px'; });
        track.style.gap = gap + 'px';
        if (type !== 'fade') goTo(current, true);
        updateNav();
      }

      function canScroll() {
        if (type === 'fade') return realCount > 1;
        return realCount > pp();
      }

      function maxIdx() { return Math.max(0, realCount - pp()); }

      function getOffset(idx) {
        var ti = (type === 'loop') ? idx + Math.min(cloneN, realCount) : idx;
        return ti * (sw + gap);
      }

      function goTo(idx, instant) {
        if (transitioning && !instant) return;

        if (type === 'fade') {
          var wrapped = ((idx % realCount) + realCount) % realCount;
          allSlides.forEach(function(s){ s.classList.remove('is-active'); });
          allSlides[wrapped].classList.add('is-active');
          current = wrapped;
          updateDots();
          updateVideos();
          return;
        }

        if (type === 'slide') {
          idx = Math.max(0, Math.min(idx, maxIdx()));
        }

        current = idx;
        var offset = getOffset(idx);

        if (instant) {
          track.style.transition = 'none';
          track.style.transform = 'translateX(-' + offset + 'px)';
          track.offsetHeight;
          track.style.transition = '';
        } else {
          transitioning = true;
          track.style.transform = 'translateX(-' + offset + 'px)';
        }

        updateArrows();
        updateDots();
        updateVideos();
      }

      function onTransEnd() {
        transitioning = false;
        if (type === 'loop') {
          if (current >= realCount) {
            goTo(current - realCount, true);
          } else if (current < 0) {
            goTo(current + realCount, true);
          }
        }
      }

      function next() {
        if (type === 'loop') { goTo(current + 1); }
        else if (type === 'fade') { goTo((current + 1) % realCount); }
        else { goTo(current + 1); }
        resetAP();
      }

      function prev() {
        if (type === 'loop') { goTo(current - 1); }
        else if (type === 'fade') { goTo((current - 1 + realCount) % realCount); }
        else { goTo(current - 1); }
        resetAP();
      }

      /* Dots */
      function buildDots() {
        dotsWrap.innerHTML = '';
        if (!canScroll()) return;
        var count = (type === 'slide') ? maxIdx() + 1 : realCount;
        for (var i = 0; i < count; i++) {
          var d = document.createElement('button');
          d.className = 'ms__dot' + (i === 0 ? ' ms__dot--active' : '');
          d.dataset.i = i;
          d.setAttribute('aria-label', 'Slide ' + (i + 1));
          d.addEventListener('click', function(){ goTo(parseInt(this.dataset.i)); resetAP(); });
          dotsWrap.appendChild(d);
        }
      }

      function updateDots() {
        var dots = dotsWrap.querySelectorAll('.ms__dot');
        var ai = (type === 'slide') ? current : ((current % realCount) + realCount) % realCount;
        dots.forEach(function(d, i){ d.classList.toggle('ms__dot--active', i === ai); });
      }

      /* Arrows */
      function updateArrows() {
        if (!prevBtn || !nextBtn) return;
        if (type === 'loop' || type === 'fade') {
          prevBtn.classList.toggle('ms__arrow--hidden', !canScroll());
          nextBtn.classList.toggle('ms__arrow--hidden', !canScroll());
          return;
        }
        prevBtn.classList.toggle('ms__arrow--hidden', current <= 0 || !canScroll());
        nextBtn.classList.toggle('ms__arrow--hidden', current >= maxIdx() || !canScroll());
      }

      function updateNav() {
        updateArrows();
        var show = canScroll();
        dotsWrap.style.display = show ? '' : 'none';
      }

      /* Videos */
      function updateVideos() {
        allSlides.forEach(function(s, i) {
          var v = s.querySelector('video');
          if (!v) return;
          var ci = (type === 'loop') ? current + Math.min(cloneN, realCount) : current;
          if (type === 'fade') {
            var vis = s.classList.contains('is-active');
          } else {
            var vis = i >= ci && i < ci + pp();
          }
          if (vis) { if (v.paused && v.autoplay) v.play().catch(function(){}); }
          else { if (!v.paused) v.pause(); }
        });
      }

      /* Autoplay */
      function startAP() { apTimer = setInterval(function(){ next(); }, speed); }
      function stopAP() { if (apTimer) { clearInterval(apTimer); apTimer = null; } }
      function resetAP() { if (doAutoplay && realCount > 1) { stopAP(); startAP(); } }

      /* Drag */
      var dragX = 0, dragging = false, dragOff = 0;
      function onDown(e) {
        if (type === 'fade' || !canScroll()) return;
        dragging = true;
        dragX = e.clientX || (e.touches && e.touches[0].clientX) || 0;
        dragOff = 0;
        track.style.transition = 'none';
        stopAP();
      }
      function onMove(e) {
        if (!dragging) return;
        var cx = e.clientX || (e.touches && e.touches[0].clientX) || 0;
        dragOff = cx - dragX;
        var base = getOffset(current);
        track.style.transform = 'translateX(' + (-base + dragOff) + 'px)';
      }
      function onUp() {
        if (!dragging) return;
        dragging = false;
        track.style.transition = '';
        var threshold = sw * 0.2;
        if (dragOff < -threshold) next();
        else if (dragOff > threshold) prev();
        else goTo(current);
        resetAP();
      }

      /* Bind */
      function bind() {
        track.addEventListener('transitionend', onTransEnd);

        if (prevBtn) prevBtn.addEventListener('click', prev);
        if (nextBtn) nextBtn.addEventListener('click', next);

        track.addEventListener('pointerdown', onDown);
        window.addEventListener('pointermove', onMove);
        window.addEventListener('pointerup', onUp);
        track.addEventListener('touchstart', function(e) { onDown(e); }, { passive: true });
        window.addEventListener('touchmove', function(e) { onMove(e); }, { passive: true });
        window.addEventListener('touchend', onUp);

        track.style.touchAction = 'pan-y';
        track.addEventListener('dragstart', function(e){ e.preventDefault(); });

        root.addEventListener('mouseenter', function(){ if (doAutoplay) stopAP(); });
        root.addEventListener('mouseleave', function(){ if (doAutoplay && realCount > 1) startAP(); });

        var rt;
        window.addEventListener('resize', function(){
          clearTimeout(rt);
          rt = setTimeout(function(){ layout(); buildDots(); }, 150);
        });
      }

      init();
    })();
  </script>
{%- endif -%}

{% style %}
  .ms {
    background-color: var(--ms-bg, rgb(var(--color-background)));
    color: var(--ms-text, rgb(var(--color-foreground)));
  }

  .ms__header {
    margin-bottom: 3rem;
  }

  .ms__title {
    margin: 0;
  }

  .ms__align--left { text-align: left; }
  .ms__align--center { text-align: center; }
  .ms__align--right { text-align: right; }

  .ms__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .ms__container { padding: 0 5rem; }
    .ms__container--d-full { max-width: none; padding: 0; }
  }

  @media screen and (max-width: 749px) {
    .ms__container--m-full { max-width: none; padding: 0; }
  }

  .ms__wrapper {
    position: relative;
  }

  .ms__viewport {
    overflow: hidden;
  }

  .ms__track {
    display: flex;
    transition: transform 0.5s ease;
    will-change: transform;
    user-select: none;
  }

  .ms__track--fade {
    display: grid;
    transition: none !important;
    transform: none !important;
  }

  .ms__track--fade .ms__slide {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }

  .ms__track--fade .ms__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .ms__slide {
    flex-shrink: 0;
  }

  .ms__slide-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ms__slide-inner {
    border-radius: var(--ms-m-radius, 0);
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .ms__slide-inner {
      border-radius: var(--ms-d-radius, 0);
    }
  }

  .ms__slide-inner img,
  .ms__slide-inner video {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .ms__slide-inner .placeholder-svg {
    width: 100%;
    height: auto;
    min-height: 20rem;
    background: rgba(var(--color-foreground), 0.04);
  }

  .ms__desc {
    margin-top: 1rem;
    font-size: 1.3rem;
    line-height: 1.5;
    text-align: center;
    opacity: 0.75;
  }

  .ms__desc p {
    margin: 0;
  }

  /* Arrows */
  .ms__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: 50%;
    width: 4.2rem;
    height: 4.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    transition: opacity 0.25s ease, background-color 0.2s;
  }

  .ms__arrow:hover {
    background-color: rgba(var(--color-foreground), 0.05);
  }

  .ms__arrow--hidden {
    opacity: 0;
    pointer-events: none;
  }

  .ms__arrow--prev { left: -5.2rem; }
  .ms__arrow--next { right: -5.2rem; }

  @media screen and (min-width: 750px) and (max-width: 1199px) {
    .ms__arrow--prev { left: 0.8rem; }
    .ms__arrow--next { right: 0.8rem; }
  }

  @media screen and (max-width: 749px) {
    .ms__arrow--prev { left: 0.5rem; }
    .ms__arrow--next { right: 0.5rem; }
  }

  /* Arrow visibility per device */
  @media screen and (min-width: 750px) {
    [data-d-arrows="hidden"] .ms__arrow { display: none !important; }
  }

  @media screen and (max-width: 749px) {
    [data-m-arrows="hidden"] .ms__arrow { display: none !important; }
  }

  /* Dots */
  .ms__dots {
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .ms__dot {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 1px solid rgba(var(--color-foreground), 0.3);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .ms__dot--active {
    background-color: rgb(var(--color-foreground));
    border-color: rgb(var(--color-foreground));
  }

  .ms__dot:hover {
    border-color: rgb(var(--color-foreground));
  }

  /* Dots position per device */
  @media screen and (min-width: 750px) {
    [data-d-dots="hidden"] .ms__dots { display: none !important; }
    [data-d-dots="over"] .ms__dots {
      margin-top: -3.5rem;
      position: relative;
      z-index: 2;
    }
    [data-d-dots="over"] .ms__dot {
      border-color: rgba(255, 255, 255, 0.5);
    }
    [data-d-dots="over"] .ms__dot--active {
      background-color: #fff;
      border-color: #fff;
    }
  }

  @media screen and (max-width: 749px) {
    [data-m-dots="hidden"] .ms__dots { display: none !important; }
    [data-m-dots="over"] .ms__dots {
      margin-top: -3rem;
      position: relative;
      z-index: 2;
    }
    [data-m-dots="over"] .ms__dot {
      border-color: rgba(255, 255, 255, 0.5);
    }
    [data-m-dots="over"] .ms__dot--active {
      background-color: #fff;
      border-color: #fff;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Media slider",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Heading alignment"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "select",
      "id": "slider_type",
      "options": [
        { "value": "slide", "label": "Classic" },
        { "value": "loop", "label": "Infinite loop" },
        { "value": "fade", "label": "Fade" }
      ],
      "default": "slide",
      "label": "Slider type",
      "info": "Fade only works when 1 slide is visible"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "default": false,
      "label": "Autoplay"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 1,
      "max": 15,
      "step": 0.5,
      "default": 5,
      "unit": "s",
      "label": "Autoplay speed"
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "checkbox",
      "id": "desktop_full_width",
      "default": false,
      "label": "Full width"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Slides per view"
    },
    {
      "type": "range",
      "id": "desktop_spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20,
      "label": "Spacing between slides"
    },
    {
      "type": "range",
      "id": "desktop_border_radius",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 0,
      "label": "Slide corner radius"
    },
    {
      "type": "select",
      "id": "desktop_dots",
      "options": [
        { "value": "hidden", "label": "Hidden" },
        { "value": "under", "label": "Under the slider" },
        { "value": "over", "label": "Over the slider" }
      ],
      "default": "under",
      "label": "Dots position"
    },
    {
      "type": "select",
      "id": "desktop_arrows",
      "options": [
        { "value": "hidden", "label": "Hidden" },
        { "value": "sides", "label": "On sides" }
      ],
      "default": "sides",
      "label": "Arrows position"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "mobile_full_width",
      "default": false,
      "label": "Full width"
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1,
      "label": "Slides per view"
    },
    {
      "type": "range",
      "id": "mobile_spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12,
      "label": "Spacing between slides"
    },
    {
      "type": "range",
      "id": "mobile_border_radius",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 0,
      "label": "Slide corner radius"
    },
    {
      "type": "select",
      "id": "mobile_dots",
