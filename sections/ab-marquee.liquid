{%- comment -%}
  A/B clone section: plain repeating text marquee (1:1 of competitor "horizontal ticker"
  urgency bars). Fully customizable: text, colors, speed, size, separator.
{%- endcomment -%}

{%- style -%}
  #AbMq-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
    white-space: nowrap;
    padding: {{ section.settings.padding_y }}px 0;
    {% if section.settings.border_color != blank %}border-top: 1px solid {{ section.settings.border_color }}; border-bottom: 1px solid {{ section.settings.border_color }};{% endif %}
  }
  #AbMq-{{ section.id }} .ab-mq__track {
    display: inline-block;
    animation: abmq-{{ section.id }} {{ section.settings.speed }}s linear infinite;
  }
  #AbMq-{{ section.id }} .ab-mq__item {
    display: inline-block;
    font-size: {{ section.settings.font_size }}px;
    font-weight: {{ section.settings.font_weight }};
    padding: 0 1.6rem;
  }
  @keyframes abmq-{{ section.id }} { from { transform: translateX(0); } to { transform: translateX(-50%); } }
{%- endstyle -%}

<div id="AbMq-{{ section.id }}" aria-label="{{ section.settings.text | escape }}">
  <div class="ab-mq__track">
    {%- for i in (1..16) -%}<span class="ab-mq__item">{{ section.settings.text }}</span>{%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "AB Marquee",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Se vend rapidement - Nombre limité !" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#B76E79" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Border color (optional)" },
    { "type": "range", "id": "font_size", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "Font size", "default": 14 },
    { "type": "select", "id": "font_weight", "label": "Font weight", "options": [ { "value": "400", "label": "Regular" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" } ], "default": "700" },
    { "type": "range", "id": "speed", "min": 10, "max": 60, "step": 5, "unit": "s", "label": "Loop duration", "default": 25 },
    { "type": "range", "id": "padding_y", "min": 4, "max": 24, "step": 2, "unit": "px", "label": "Vertical padding", "default": 10 }
  ],
  "presets": [{ "name": "AB Marquee" }]
}
{% endschema %}
