        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Badge image 1"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Badge image 2"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Badge image 3"
        },
        {
          "type": "image_picker",
          "id": "image_4",
          "label": "Badge image 4"
        },
        {
          "type": "text",
          "id": "custom_text",
          "label": "Text below badges"
        }
      ]
    },
    {
      "type": "text",
