{%- comment -%}
  A/B clone section: horizontal trust-badge band (emoji + short label) with optional
  payment icons row. Mirrors the competitor's assurance bar under the buy box.
{%- endcomment -%}

{%- style -%}
  #AbTrust-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #AbTrust-{{ section.id }} .ab-trust__items {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.2rem 2.6rem;
    max-width: 90rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  #AbTrust-{{ section.id }} .ab-trust__item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.3;
  }
  #AbTrust-{{ section.id }} .ab-trust__emoji { font-size: 1.7rem; line-height: 1; }
  #AbTrust-{{ section.id }} .ab-trust__payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }
  #AbTrust-{{ section.id }} .ab-trust__payments svg { height: 2.4rem; width: auto; }
  @media screen and (max-width: 749px) {
    #AbTrust-{{ section.id }} .ab-trust__items { gap: 0.9rem 1.6rem; }
    #AbTrust-{{ section.id }} .ab-trust__item { font-size: 1.2rem; }
  }
{%- endstyle -%}

<div id="AbTrust-{{ section.id }}" class="color-{{ section.settings.color_scheme }} gradient">
  <div class="ab-trust__items">
    {%- for block in section.blocks -%}
      <div class="ab-trust__item" {{ block.shopify_attributes }}>
        {%- if block.settings.emoji != blank -%}<span class="ab-trust__emoji" aria-hidden="true">{{ block.settings.emoji }}</span>{%- endif -%}
        <span>{{ block.settings.text }}</span>
      </div>
    {%- endfor -%}
  </div>
  {%- if section.settings.show_payment_icons -%}
    <div class="ab-trust__payments">
      {%- for type in shop.enabled_payment_types -%}
        {{ type | payment_type_svg_tag: class: 'icon' }}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "AB Trust badges",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 24 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji / icon character" },
        { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Paiement sécurisé" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "AB Trust badges", "blocks": [{ "type": "badge" }, { "type": "badge" }, { "type": "badge" }] }
  ]
}
{% endschema %}
