{%- liquid
  assign speed = section.settings.speed | default: 30
  assign has_items = false
  for block in section.blocks
    if block.type == 'text' and block.settings.text != blank
      assign has_items = true
      break
    elsif block.type == 'image' and block.settings.image != blank
      assign has_items = true
      break
    endif
  endfor
-%}

{%- style -%}
  .ticker-{{ section.id }} {
    --ticker-speed: {{ speed }}s;
    --ticker-gap: {{ section.settings.gap }}px;
    --ticker-padding-top: {{ section.settings.padding_top }}px;
    --ticker-padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.use_custom_bg and section.settings.custom_bg_color != blank %}
      --ticker-bg: {{ section.settings.custom_bg_color }};
    {% endif %}
    {% if section.settings.use_custom_bg and section.settings.custom_text_color != blank %}
      --ticker-text: {{ section.settings.custom_text_color }};
    {% endif %}
  }
{%- endstyle -%}

{%- if has_items -%}
  {%- capture ticker_items -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'text' and block.settings.text != blank -%}
        <span class="ticker__item ticker__item--text {{ block.settings.text_size }}" {{ block.shopify_attributes }}>
          {{- block.settings.text -}}
        </span>
      {%- elsif block.type == 'image' and block.settings.image != blank -%}
        <span class="ticker__item ticker__item--image" {{ block.shopify_attributes }}>
          <img
            src="{{ block.settings.image | image_url: height: block.settings.image_height }}"
            alt="{{ block.settings.image.alt | escape }}"
            height="{{ block.settings.image_height }}"
            width="{{ block.settings.image_height | times: block.settings.image.aspect_ratio | round }}"
            loading="lazy"
          >
        </span>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  <div class="ticker-section ticker-{{ section.id }} color-{{ section.settings.color_scheme }}" role="marquee" aria-label="Scrolling content">
    <div class="ticker__inner" data-ticker>
      <div class="ticker__track">{{ ticker_items }}</div>
    </div>
  </div>

  <script>
    (function(){
      var wrapper = document.querySelector('.ticker-{{ section.id }} [data-ticker]');
      if (!wrapper) return;
      var track = wrapper.querySelector('.ticker__track');
      if (!track) return;
      function fill() {
        var vw = window.innerWidth;
        var copies = Math.ceil((vw * 2) / track.scrollWidth) + 1;
        var existing = wrapper.querySelectorAll('.ticker__track').length;
        for (var i = existing; i < copies + 1; i++) {
          var clone = track.cloneNode(true);
          clone.setAttribute('aria-hidden', 'true');
          clone.querySelectorAll('[id]').forEach(function(el){ el.removeAttribute('id'); });
          wrapper.appendChild(clone);
        }
      }
      fill();
    })();
  </script>
{%- endif -%}

{% style %}
  .ticker-section {
    overflow: hidden;
    padding-top: var(--ticker-padding-top, 0);
    padding-bottom: var(--ticker-padding-bottom, 0);
    background-color: var(--ticker-bg, rgb(var(--color-background)));
    color: var(--ticker-text, rgb(var(--color-foreground)));
  }

  .ticker__inner {
    display: flex;
    width: max-content;
    animation: ticker-scroll var(--ticker-speed, 30s) linear infinite;
  }

  .ticker__track {
    display: flex;
    align-items: center;
    gap: var(--ticker-gap, 40px);
    padding-right: var(--ticker-gap, 40px);
    flex-shrink: 0;
  }

  .ticker__item {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .ticker__item--text {
    font-weight: inherit;
    line-height: 1.3;
  }

  .ticker__item--text.text-small {
    font-size: 1.2rem;
  }

  .ticker__item--text.text-medium {
    font-size: 1.6rem;
  }

  .ticker__item--text.text-large {
    font-size: 2rem;
  }

  .ticker__item--text.text-xlarge {
    font-size: 2.8rem;
  }

  .ticker__item--image img {
    display: block;
    height: auto;
    max-height: 100%;
    object-fit: contain;
  }

  .ticker-section:hover .ticker__inner {
    animation-play-state: paused;
  }

  @keyframes ticker-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Ticker",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 100,
      "step": 5,
      "default": 30,
      "unit": "s",
      "label": "Scrolling speed",
      "info": "Lower = faster"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 10,
      "max": 200,
      "step": 10,
      "default": 40,
      "unit": "px",
      "label": "Gap between items"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_custom_bg",
      "default": false,
      "label": "Use custom colors"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 0,
      "unit": "px",
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 0,
      "unit": "px",
      "label": "Bottom padding"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Scrolling text",
          "label": "Text"
        },
        {
          "type": "select",
          "id": "text_size",
          "options": [
            {
              "value": "text-small",
              "label": "Small"
            },
            {
              "value": "text-medium",
              "label": "Medium"
            },
            {
              "value": "text-large",
              "label": "Large"
            },
            {
              "value": "text-xlarge",
              "label": "Extra large"
            }
          ],
          "default": "text-medium",
          "label": "Text size"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_height",
          "min": 16,
          "max": 120,
          "step": 4,
          "default": 40,
          "unit": "px",
          "label": "Image height"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ticker",
      "blocks": [
        {
          "type": "text",
          "settings": {
            "text": "Free shipping on orders over $50"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "30-day money back guarantee"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "New arrivals every week"
          }
        }
      ]
    }
  ]
}
{% endschema %}
