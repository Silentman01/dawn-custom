{%- style -%}
  .nlc-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.section_bg }};
  }
  .nlc-{{ section.id }} .nlc__heading {
    text-align: center;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 3rem;
    color: {{ section.settings.heading_color }};
  }
  .nlc-{{ section.id }} .nlc__cards {
    display: flex;
    align-items: stretch;
    justify-content: center;
    max-width: 88rem;
    margin: 0 auto;
  }
  .nlc-{{ section.id }} .nlc__card { display: flex; flex-direction: column; }
  .nlc-{{ section.id }} .nlc__card--brand { flex: 1; background: {{ section.settings.brand_bg }}; border-radius: 2.4rem 0 0 2.4rem; }
  .nlc-{{ section.id }} .nlc__card--comp { flex: 1; background: {{ section.settings.comp_bg }}; border-radius: 0 2.4rem 2.4rem 0; }
  .nlc-{{ section.id }} .nlc__card--center {
    flex: 0 0 15rem;
    background: #fff;
    border-radius: 2rem;
    box-shadow: 0 8px 30px rgba(0,0,0,0.12);
    z-index: 2;
    margin: 0 -1.2rem;
  }
  /* headers (fixed height so rows below stay aligned across the 3 cards) */
  .nlc-{{ section.id }} .nlc__head {
    min-height: 15rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: 2rem 1.2rem 1.4rem;
    text-align: center;
  }
  .nlc-{{ section.id }} .nlc__brandname { font-size: 2.6rem; font-weight: 800; margin: 0 0 1rem; color: {{ section.settings.brand_name_color }}; }
  .nlc-{{ section.id }} .nlc__compname { font-size: 2.1rem; font-weight: 700; margin: 0 0 1rem; color: {{ section.settings.comp_name_color }}; }
  .nlc-{{ section.id }} .nlc__head img { max-height: 9rem; width: auto; object-fit: contain; display: block; }
  /* rows */
  .nlc-{{ section.id }} .nlc__feat, .nlc-{{ section.id }} .nlc__label {
    min-height: 5.6rem;
    display: flex;
    align-items: center;
    padding: 0.8rem 1.4rem;
  }
  .nlc-{{ section.id }} .nlc__card--center .nlc__label:last-child { padding-bottom: 1.4rem; }
  .nlc-{{ section.id }} .nlc__label {
    justify-content: center;
    text-align: center;
    font-size: 1.25rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: {{ section.settings.label_color }};
  }
  .nlc-{{ section.id }} .nlc__pill {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    background: #fff;
    border-radius: 100px;
    padding: 0.7rem 1.3rem;
    width: 100%;
    font-size: 1.4rem;
    line-height: 1.2;
  }
  .nlc-{{ section.id }} .nlc__card--comp .nlc__pill { flex-direction: row-reverse; text-align: right; }
  .nlc-{{ section.id }} .nlc__pilltext { flex: 1; }
  .nlc-{{ section.id }} .nlc__card--brand .nlc__pilltext { color: {{ section.settings.brand_text_color }}; }
  .nlc-{{ section.id }} .nlc__card--comp .nlc__pilltext { color: {{ section.settings.comp_text_color }}; }
  .nlc-{{ section.id }} .nlc__icon { width: 2rem; height: 2rem; flex-shrink: 0; }
  .nlc-{{ section.id }} .nlc__icon svg { width: 100%; height: 100%; display: block; }
  .nlc-{{ section.id }} .nlc__icon--star { color: {{ section.settings.brand_accent }}; }
  .nlc-{{ section.id }} .nlc__icon--minus { color: {{ section.settings.comp_accent }}; }
  @media screen and (max-width: 749px) {
    .nlc-{{ section.id }} .nlc__card--center { flex-basis: 8.5rem; margin: 0 -0.6rem; }
    .nlc-{{ section.id }} .nlc__head { min-height: 11rem; padding: 1.2rem 0.5rem 1rem; }
    .nlc-{{ section.id }} .nlc__head img { max-height: 5rem; }
    .nlc-{{ section.id }} .nlc__brandname { font-size: 1.7rem; }
    .nlc-{{ section.id }} .nlc__compname { font-size: 1.5rem; }
    .nlc-{{ section.id }} .nlc__feat, .nlc-{{ section.id }} .nlc__label { min-height: 6.4rem; padding: 0.6rem 0.6rem; }
    .nlc-{{ section.id }} .nlc__pill { font-size: 1.05rem; padding: 0.5rem 0.8rem; gap: 0.4rem; }
    .nlc-{{ section.id }} .nlc__icon { width: 1.5rem; height: 1.5rem; }
    .nlc-{{ section.id }} .nlc__label { font-size: 0.9rem; }
  }
{%- endstyle -%}

{%- capture star -%}<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.1-1.01L12 2z"/></svg>{%- endcapture -%}
{%- capture minus -%}<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11H7v-2h10v2z"/></svg>{%- endcapture -%}

<div class="nlc-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="nlc__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="page-width">
    <div class="nlc__cards">
      <!-- brand card -->
      <div class="nlc__card nlc__card--brand">
        <div class="nlc__head">
          <p class="nlc__brandname">{{ section.settings.brand_name }}</p>
          {%- if section.settings.brand_image != blank -%}
            <img src="{{ section.settings.brand_image | image_url: width: 400 }}" alt="{{ section.settings.brand_name | escape }}" loading="lazy">
          {%- endif -%}
        </div>
        {%- for block in section.blocks -%}
          <div class="nlc__feat" {{ block.shopify_attributes }}>
            <div class="nlc__pill">
              <span class="nlc__icon nlc__icon--star">{{ star }}</span>
              <span class="nlc__pilltext">{{ block.settings.brand_text }}</span>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <!-- center label card -->
      <div class="nlc__card nlc__card--center">
        <div class="nlc__head nlc__head--center"></div>
        {%- for block in section.blocks -%}
          <div class="nlc__label">{{ block.settings.label }}</div>
        {%- endfor -%}
      </div>
      <!-- competitor card -->
      <div class="nlc__card nlc__card--comp">
        <div class="nlc__head">
          <p class="nlc__compname">{{ section.settings.comp_name }}</p>
          {%- if section.settings.comp_image != blank -%}
            <img src="{{ section.settings.comp_image | image_url: width: 400 }}" alt="{{ section.settings.comp_name | escape }}" loading="lazy">
          {%- endif -%}
        </div>
        {%- for block in section.blocks -%}
          <div class="nlc__feat">
            <div class="nlc__pill">
              <span class="nlc__icon nlc__icon--minus">{{ minus }}</span>
              <span class="nlc__pilltext">{{ block.settings.comp_text }}</span>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "NL Comparison",
  "tag": "section",
  "class": "section-nl-comparison",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 48, "step": 2, "unit": "px", "default": 32 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1e1e1e" },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#ffffff" },
    { "type": "header", "content": "Our brand (left)" },
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "nailys" },
    { "type": "image_picker", "id": "brand_image", "label": "Brand image (pen)" },
    { "type": "color", "id": "brand_bg", "label": "Brand card background", "default": "#ffd9ea" },
    { "type": "color", "id": "brand_name_color", "label": "Brand name color", "default": "#1e1e1e" },
    { "type": "color", "id": "brand_text_color", "label": "Brand text color", "default": "#1e1e1e" },
    { "type": "color", "id": "brand_accent", "label": "Brand icon (star) color", "default": "#e8467e" },
    { "type": "header", "content": "Competitor (right)" },
    { "type": "text", "id": "comp_name", "label": "Competitor name", "default": "Vernis classique" },
    { "type": "image_picker", "id": "comp_image", "label": "Competitor image (bottle)" },
    { "type": "color", "id": "comp_bg", "label": "Competitor card background", "default": "#ececec" },
    { "type": "color", "id": "comp_name_color", "label": "Competitor name color", "default": "#1e1e1e" },
    { "type": "color", "id": "comp_text_color", "label": "Competitor text color", "default": "#555555" },
    { "type": "color", "id": "comp_accent", "label": "Competitor icon (minus) color", "default": "#b0b0b0" },
    { "type": "header", "content": "Center labels" },
    { "type": "color", "id": "label_color", "label": "Label color", "default": "#1e1e1e" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "label", "label": "Center label", "default": "TEMPS DE SÉCHAGE" },
        { "type": "text", "id": "brand_text", "label": "Our text", "default": "Ultra rapide" },
        { "type": "text", "id": "comp_text", "label": "Competitor text", "default": "Long à sécher" }
      ]
    }
  ],
  "presets": [
    { "name": "NL Comparison" }
  ]
}
{% endschema %}
