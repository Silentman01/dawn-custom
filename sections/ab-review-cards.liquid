{%- comment -%}
  A/B clone section: review cards — EXACT mirror of the competitor's reviews section CSS
  (2026-07-14, from their live section code): 300-320px white cards, 220px cover image,
  Playfair Display serif titles, DM Sans body, gold letter-spaced stars, hidden-scrollbar
  horizontal snap scroll (no arrows), hover lift. Fully parameterized.
{%- endcomment -%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@400;500;600&display=swap');

  #AbRev-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #AbRev-{{ section.id }} .ab-rev__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    font-family: 'DM Sans', sans-serif;
  }
  #AbRev-{{ section.id }} .ab-rev__heading {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 700;
    text-align: center;
    margin: 0 0 40px;
    color: {{ section.settings.title_color }};
  }
  #AbRev-{{ section.id }} .ab-rev__grid {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    touch-action: pan-x pan-y;
    overscroll-behavior-x: contain;
    width: 100%;
    max-width: 100%;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 16px;
    scrollbar-width: none;
  }
  #AbRev-{{ section.id }} .ab-rev__grid::-webkit-scrollbar { display: none; }
  #AbRev-{{ section.id }} .ab-rev__card {
    min-width: 300px;
    max-width: 320px;
    flex-shrink: 0;
    scroll-snap-align: start;
    background: {{ section.settings.card_bg }};
    border: 1px solid {{ section.settings.card_border }};
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 16px rgba(0,0,0,0.04);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  #AbRev-{{ section.id }} .ab-rev__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
  }
  #AbRev-{{ section.id }} .ab-rev__card img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
  }
  #AbRev-{{ section.id }} .ab-rev__body { padding: 20px 22px 24px; }
  #AbRev-{{ section.id }} .ab-rev__stars {
    color: {{ section.settings.star_color }};
    font-size: 15px;
    letter-spacing: 2px;
    margin-bottom: 10px;
  }
  #AbRev-{{ section.id }} .ab-rev__title {
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    margin: 0 0 8px;
    line-height: 1.3;
  }
  #AbRev-{{ section.id }} .ab-rev__quote {
    font-size: 14px;
    line-height: 1.65;
    color: #555555;
    margin: 0 0 14px;
  }
  #AbRev-{{ section.id }} .ab-rev__quote strong { color: {{ section.settings.title_color }}; }
  #AbRev-{{ section.id }} .ab-rev__quote p { margin: 0; font-size: 14px; line-height: 1.65; }
  #AbRev-{{ section.id }} .ab-rev__author {
    font-size: 13px;
    color: #999999;
    font-weight: 500;
  }
  @media (max-width: 768px) {
    #AbRev-{{ section.id }} .ab-rev__card { min-width: 270px; max-width: 280px; }
    #AbRev-{{ section.id }} .ab-rev__card img { height: 180px; }
    #AbRev-{{ section.id }} .ab-rev__heading { font-size: 22px; }
  }
{%- endstyle -%}

<div id="AbRev-{{ section.id }}" class="color-{{ section.settings.color_scheme }} gradient">
  <div class="ab-rev__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="ab-rev__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="ab-rev__grid">
      {%- for block in section.blocks -%}
        <div class="ab-rev__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640' }}
          {%- endif -%}
          <div class="ab-rev__body">
            <div class="ab-rev__stars" aria-hidden="true">★★★★★</div>
            {%- if block.settings.title != blank -%}<p class="ab-rev__title">{{ block.settings.title }}</p>{%- endif -%}
            <div class="ab-rev__quote">{{ block.settings.quote }}</div>
            <div class="ab-rev__author">{{ block.settings.author }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "AB Review cards",
  "tag": "section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Ce que nos clientes en pensent" },
    { "type": "text", "id": "subheading", "label": "Subheading (unused, kept for compat)" },
    { "type": "color", "id": "star_color", "label": "Star color", "default": "#E8A33D" },
    { "type": "color", "id": "title_color", "label": "Title color", "default": "#1A1A1A" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#F0ECE6" },
    { "type": "color", "id": "accent_color", "label": "Accent (compat)", "default": "#B76E79" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 52 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "title", "label": "Bold quote title" },
        { "type": "richtext", "id": "quote", "label": "Quote (bold = emphasized sentence)" },
        { "type": "text", "id": "author", "label": "Author line" },
        { "type": "text", "id": "verified_text", "label": "(compat, unused)" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    { "name": "AB Review cards", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }
  ]
}
{% endschema %}
