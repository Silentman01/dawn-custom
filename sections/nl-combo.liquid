{%- comment -%} Nailys — combo/bundle section (build 2026-07-19). Presentational
  bundle: product blocks with price + running total + CTA. All fields customizable. {%- endcomment -%}
<style>
  #nlcombo-{{ section.id }} { --acc: {{ section.settings.accent }}; --bg: {{ section.settings.bg }}; --card: {{ section.settings.card }}; --ink: {{ section.settings.ink }}; --soft: {{ section.settings.soft }};
    background: var(--bg); padding: {{ section.settings.padding_top }}px 18px {{ section.settings.padding_bottom }}px; }
  #nlcombo-{{ section.id }} .nlc-wrap { max-width: 760px; margin: 0 auto; text-align: center; }
  #nlcombo-{{ section.id }} .nlc-h { font-size: clamp(22px,4vw,30px); font-weight: 800; color: var(--ink); margin: 0 0 8px; }
  #nlcombo-{{ section.id }} .nlc-h em { color: var(--acc); font-style: normal; }
  #nlcombo-{{ section.id }} .nlc-pitch { color: var(--ink); opacity: .8; font-size: 14px; max-width: 560px; margin: 0 auto 22px; line-height: 1.6; }
  #nlcombo-{{ section.id }} .nlc-items { display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; }
  #nlcombo-{{ section.id }} .nlc-item { background: var(--card); border: 1px solid var(--soft); border-radius: 16px; padding: 16px; width: 190px; }
  #nlcombo-{{ section.id }} .nlc-item img { width: 100%; height: 130px; object-fit: contain; border-radius: 10px; margin-bottom: 10px; }
  #nlcombo-{{ section.id }} .nlc-item .t { font-weight: 700; font-size: 13px; color: var(--ink); margin-bottom: 4px; }
  #nlcombo-{{ section.id }} .nlc-item .p { font-weight: 800; color: var(--acc); }
  #nlcombo-{{ section.id }} .nlc-item .c { color: var(--ink); opacity: .45; text-decoration: line-through; font-size: 12px; margin-left: 5px; }
  #nlcombo-{{ section.id }} .nlc-plus { font-size: 24px; color: var(--acc); font-weight: 800; }
  #nlcombo-{{ section.id }} .nlc-total { font-size: 16px; color: var(--ink); margin-bottom: 16px; }
  #nlcombo-{{ section.id }} .nlc-total b { color: var(--acc); font-size: 20px; }
  #nlcombo-{{ section.id }} .nlc-total .c { text-decoration: line-through; opacity: .5; margin-left: 6px; font-size: 14px; }
  #nlcombo-{{ section.id }} .nlc-cta { display: inline-block; background: var(--acc); color: #fff; font-weight: 700; padding: 14px 34px; border-radius: 100px; text-decoration: none; }
</style>
<div id="nlcombo-{{ section.id }}">
  <div class="nlc-wrap">
    <h2 class="nlc-h">{{ section.settings.heading }}</h2>
    {%- if section.settings.pitch != blank -%}<p class="nlc-pitch">{{ section.settings.pitch }}</p>{%- endif -%}
    <div class="nlc-items">
      {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
          {%- unless forloop.first -%}<span class="nlc-plus" aria-hidden="true">+</span>{%- endunless -%}
          <div class="nlc-item" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}<img src="{{ block.settings.image | image_url: width: 380 }}" alt="{{ block.settings.title | escape }}" loading="lazy">{%- endif -%}
            <div class="t">{{ block.settings.title }}</div>
            <div><span class="p">{{ block.settings.price }}</span>{%- if block.settings.compare != blank -%}<span class="c">{{ block.settings.compare }}</span>{%- endif -%}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="nlc-total">{{ section.settings.total_label }} <b>{{ section.settings.total }}</b>{%- if section.settings.total_compare != blank -%}<span class="c">{{ section.settings.total_compare }}</span>{%- endif -%}</div>
    {%- if section.settings.cta_text != blank -%}<a class="nlc-cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_text }}</a>{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Nailys combo",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "L'association parfaite" },
    { "type": "textarea", "id": "pitch", "label": "Pitch", "default": "Pour un rendu encore plus bluffant et une tenue qui dure : la base et le top coat subliment votre pose, pendant que le dissolvant magique retire tout en un clin d'oeil." },
    { "type": "text", "id": "total_label", "label": "Total label", "default": "Prix total :" },
    { "type": "text", "id": "total", "label": "Total", "default": "24,98 €" },
    { "type": "text", "id": "total_compare", "label": "Total compare", "default": "34,98 €" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Ajouter le combo à mon panier" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#E8467E" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFF6FB" },
    { "type": "color", "id": "card", "label": "Card", "default": "#FFFFFF" },
    { "type": "color", "id": "soft", "label": "Border", "default": "#FFC3DC" },
    { "type": "color", "id": "ink", "label": "Ink", "default": "#1E1E1E" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "label": "Padding bottom", "default": 48 }
  ],
  "blocks": [
    { "type": "item", "name": "Product", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Title", "default": "Produit" },
      { "type": "text", "id": "price", "label": "Price", "default": "14,99 €" },
      { "type": "text", "id": "compare", "label": "Compare price", "default": "19,99 €" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "Nailys combo", "blocks": [
    { "type": "item", "settings": { "title": "Base et Top Coat", "price": "14,99 €", "compare": "19,99 €" } },
    { "type": "item", "settings": { "title": "Dissolvant magique", "price": "9,99 €", "compare": "14,99 €" } }
  ] } ]
}
{% endschema %}
