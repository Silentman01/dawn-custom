        "collapsible_tab_desc": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Does it actually work? How fast?",
            "icon": "none",
            "content": "<p><strong>Yes — and you’ll feel the difference the first shower.</strong> The cool, clean finish is immediate; the all day odor control and comfort build as <strong>CoolBro</strong> replaces the harsh, high pH soap that was quietly working against you. Most men make it their daily wash within a week.</p>",
            "page": ""
          }
        },
        "collapsible_tab_why": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "How do I use it?",
            "icon": "none",
            "content": "<p>In the shower, <strong>once a day</strong>:</p><ol><li>Lather a small amount in your hands<br/></li><li>Massage gently over the groin, inner thighs and anywhere that traps heat<br/></li><li>Leave it on <strong>30 to 60 seconds</strong><br/></li><li>Rinse well and <strong>pat dry</strong>, especially the folds<br/></li></ol><p>Use daily — fresh below the belt becomes the default, not the exception.</p>",
            "page": ""
          }
        },
        "collapsible_tab_benefits": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "What’s in it? Is it gentle?",
            "icon": "none",
            "content": "<p>Built around skin friendly actives chosen for one job each:</p><ul><li><strong>Menthol</strong> — instant cooling</li><li><strong>Zinc ricinoleate</strong> — neutralises odor (doesn’t mask it)</li><li><strong>Ceramides + glycerin</strong> — lock in moisture</li><li><strong>Fermented probiotics</strong> — protect your skin’s natural balance</li><li>An <strong>aloe + bamboo + moringa</strong> soothing complex</li></ul><p>No sulphates, parabens, silicones or artificial colours.</p>",
            "page": ""
          }
        },
        "collapsible_tab_use": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "What if it’s not for me? Shipping & guarantee",
            "icon": "none",
            "content": "<p>You buy <strong>risk free</strong>: CoolBro comes with a <strong>30 day money back guarantee</strong> and <strong>tracked shipping</strong> on every order.<br/><br/>If it’s not your thing, email us and we’ll sort it — no awkward questions.</p><p>support@coolbro.co</p>",
            "page": ""
          }
        },
        "collapsible_tab_guarantee": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & guarantee",
            "icon": "none",
            "content": "<p>Every order ships tracked, and you’re covered by a <strong>30 day satisfaction guarantee</strong>. Not happy? You get your money back.</p>",
            "page": ""
          }
        },
