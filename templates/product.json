          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/coolbro_ing_zinc.png",
            "title": "<strong>Zinc Ricinoleate</strong>",
            "text": "Traps and neutralises odor molecules instead of burying them under fragrance. The smell doesn’t get masked — it’s gone.",
            "card_bg_color": ""
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/coolbro_ing_ceramides.png",
            "title": "<strong>Ceramides & Glycerin</strong>",
            "text": "Lock moisture back into the skin after washing, so you skip the next day tightness, itch and irritation harsh soap leaves behind.",
            "card_bg_color": ""
          }
        },
        "card_4": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/coolbro_ing_botanical.png",
            "title": "<strong>Aloe, Bamboo & Moringa</strong>",
            "text": "A plant based soothing complex that calms redness and sensitivity — especially handy if you trim. Purposeful, not filler.",
            "card_bg_color": ""
          }
        }
