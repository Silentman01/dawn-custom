        "collapsible_row_jgAFHc": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Combien de temps la porter ?",
            "icon": "none",
            "row_content": "<p>Au quotidien, plusieurs semaines. La plupart des clientes voient une différence <strong>dès la 2e ou 3e semaine</strong> et continuent 2 à 3 mois pour installer le résultat.</p>",
            "page": ""
          }
        },
