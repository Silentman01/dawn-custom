            "author_image": "shopify://shop_images/strideback-avatar-2.png",
            "tag_1": "CCL rupture",
            "tag_2": "3-month update",
            "card_bg_color": ""
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "rating": "4.8",
            "quote": "\"Two weeks in, he stopped that little cry when he gets up.\"",
            "details": "I spent countless hours on contradicting forum threads and felt like a mess. We're on month three now: he's bearing weight on both legs pretty evenly and I finally feel like I'm doing enough for him.",
