    "reasons_why_VdQFQx": {
      "type": "reasons-why",
      "blocks": {
        "reason_card_XmWM9Y": {
          "type": "reason_card",
          "settings": {
            "image": "shopify://shop_images/drw2_0cb6b337-84f9-414b-8f31-4f78d585c11f.png",
            "label": "Raison 1",
            "heading": "Elle travaille, les autres se contentent de contenir",
            "details": "<p>L'inox est neutre. Le plastique contamine. Le cuivre, lui, purifie activement l'eau qui repose à son contact : c'est le seul contenant du marché qui améliore ce qu'on y verse.</p>"
          }
        },
        "reason_card_493cPn": {
          "type": "reason_card",
          "settings": {
            "image": "shopify://shop_images/drw2_0cb6b337-84f9-414b-8f31-4f78d585c11f.png",
            "label": "Raison 2",
            "heading": "5 000 ans de recul, pas une tendance",
            "details": "<p>Le Tamra Jal traverse les siècles pendant que les tendances santé passent. Dans un monde saturé de gadgets bien-être, un rituel millénaire confirmé par la science moderne est une valeur sûre.</p>"
          }
        },
        "reason_card_HHJT9J": {
          "type": "reason_card",
          "settings": {
            "image": "shopify://shop_images/drw3_189b4c66-d713-4e14-9850-187be932002e.png",
            "label": "Raison 3",
            "heading": "Du cuivre pur jusqu'au fond",
            "details": "<p>Beaucoup de gourdes \"cuivre\" sont des placages sur de l'inox, avec vernis intérieur. La Cuivra™ est massive et nue : votre eau ne touche que du cuivre 99,9%, dedans comme dehors.</p>"
          }
        },
        "reason_card_VCdJrA": {
          "type": "reason_card",
          "settings": {
            "image": "shopify://shop_images/drw4_3ece4dd2-fe65-4f8e-92f8-9ff6a916fd65.png",
            "label": "Raison 4",
            "heading": "Un objet, pas un consommable",
            "details": "<p>Martelée à la main, unique, faite pour durer des décennies et embellir en vieillissant. Pendant ce temps, les gourdes classiques se rayent, se cabossent et se remplacent.</p>"
          }
        },
        "reason_card_Np8tDa": {
          "type": "reason_card",
          "settings": {
            "image": "shopify://shop_images/drw5.png",
            "label": "Raison 5",
            "heading": "30 jours pour installer le rituel",
            "details": "<p>Satisfait ou remboursé pendant un mois : le temps d'adopter le geste du soir et le verre du matin. Si le rituel ne prend pas, retour et remboursement intégral.</p>"
          }
        }
      },
