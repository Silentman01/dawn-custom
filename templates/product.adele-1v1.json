          "type": "collapsible_row",
          "settings": {
            "heading": "Est-ce hygiénique ?",
            "icon": "none",
            "row_content": "<p>Oui. La cire d’abeille est <strong>naturellement antibactérienne</strong>. Un rinçage à l’eau froide suffit pour l’entretenir.</p>"
          }
        },
        "q4": {
          "type": "collapsible_row",
          "settings": {
