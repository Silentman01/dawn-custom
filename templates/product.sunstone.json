    "testimonial_slider": {
      "type": "testimonial-slider",
      "blocks": {
        "r1": {
          "type": "review",
          "settings": {
            "rating": "5.0",
            "quote": "\"I went from 3 coffees to zero\"",
            "details": "I've been running on caffeine for 6 years. 3 cups minimum just to function. By 2pm I'd crash so hard I'd nap in my car during lunch.\nPut this on my wrist. First week, subtle. Second week, I forgot my afternoon coffee. Third week, I realized I hadn't had coffee in 2 days and I felt... fine? Better than fine.\nI have real energy now. Not borrowed. Not jittery. Mine.",
            "author_name": "ASHLEY M.",
            "tag_1": "Caffeine-Free",
            "tag_2": "Real Energy",
            "card_bg_color": ""
          }
        },
        "r2": {
          "type": "review",
          "settings": {
            "rating": "5.0",
            "quote": "\"My kids got the fun mom back\"",
            "details": "I was the tired mom. The 'not now' mom. The 'I'll play later' mom who never played later because later I was even more exhausted.\nI've tried B12, iron, ashwagandha, a thyroid supplement, and those little energy gummy things. Nothing stuck.\n4 weeks with this bracelet and I'm doing bedtime without dreading it. I'm playing in the yard after dinner. My daughter said 'mommy you're fun again.' I'm keeping this on my wrist forever.",
            "author_name": "BRITTANY L.",
            "tag_1": "Mom Energy",
            "tag_2": "Playing Again",
            "card_bg_color": ""
          }
        },
        "r3": {
          "type": "review",
          "settings": {
            "rating": "5.0",
            "quote": "\"The 2pm crash just... stopped\"",
            "details": "Like clockwork, every day at 2pm I'd hit a wall. Eyelids heavy, brain offline, reaching for anything caffeinated.\nThis bracelet didn't give me a spike of energy. It's more like the floor rose. I stopped crashing. The low point just... wasn't as low. Then it wasn't there at all.\n6 weeks in. I work until 5pm sharp and focused. Then I cook dinner. That sentence would have been science fiction 2 months ago.",
            "author_name": "NICOLE R.",
            "tag_1": "2pm Crash",
            "tag_2": "Gone",
            "card_bg_color": ""
          }
        },
        "r4": {
          "type": "review",
          "settings": {
            "rating": "5.0",
            "quote": "\"I feel like myself again — the real version\"",
            "details": "I used to be the person with energy. The one who organized everything, showed up early, had hobbies.\nSomewhere in the last 3 years, that person disappeared. I attributed it to kids, work, aging. I accepted it.\nThis bracelet made me question that acceptance. 3 weeks in and I'm waking up without dread. I'm laughing more. I'm doing things after 7pm again.\nI'm not 25. But I feel like ME. The real me. Not the depleted version.",
            "author_name": "TONYA S.",
            "tag_1": "Felt Like Myself",
            "tag_2": "Energy Back",
            "card_bg_color": ""
          }
        },
        "r5": {
          "type": "review",
          "settings": {
            "rating": "4.8",
            "quote": "\"Caffeine is a loan. This is a deposit.\"",
            "details": "Someone in the reviews said that and it stuck with me. That's exactly what this feels like.\nI was borrowing energy from tomorrow every single day — coffee, energy drinks, pre-workout. And every tomorrow started deeper in the hole.\nThis bracelet doesn't give you a hit. It gives you a slow, steady rise back to baseline. Like your body remembering how to make energy on its own.\nI'm not wired. I'm not crashing. I'm just... present. All day. That's new.",
            "author_name": "DANIELLE W.",
            "tag_1": "No More Borrowing",
            "tag_2": "Steady Energy",
            "card_bg_color": ""
          }
        }
      },
